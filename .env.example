NODE_ENV=development
PORT=3000

# Neon Postgres connection string. Get from the Neon dashboard.
DATABASE_URL=

# JWT signing secrets. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_OTP_SECRET=
JWT_RESET_SECRET=

# Google OAuth. Get from Google Cloud Console (localhost:3000 was already registered before the hardware failure).
GOOGLE_CLIENT_ID=

# Optional
TURNSTILE_SECRET_KEY=
CORS_ORIGINS=
