NODE_ENV=development
PORT=3000

# Neon Postgres connection string. Get from the Neon dashboard.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT signing secrets. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=generate-with-openssl-rand-hex-32
JWT_OTP_SECRET=generate-with-openssl-rand-hex-32
JWT_RESET_SECRET=generate-with-openssl-rand-hex-32

# Google OAuth. Get from Google Cloud Console (localhost:3000 was already registered before the hardware failure).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
CORS_ORIGINS=http://localhost:5173,https://app.example.com

# Base URL used to build links sent in emails (e.g. staff invite accept links).
APP_BASE_URL=https://app.hantios.com

# Hours a staff invite token stays valid before it must be re-issued.
STAFF_INVITE_EXPIRY_HOURS=72

# Hours a signup email-verification link stays valid before it must be re-sent.
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# Module 33 Session 4A -- Real Email Sending (Resend). Both optional/fail-soft:
# absent means the app falls back to console-logging emails instead of
# sending them for real (safe default for local dev). Get RESEND_API_KEY from
# the Resend dashboard. RESEND_FROM_EMAIL must be an address on a domain
# verified in that same Resend account (Domains -> your domain -> status
# "verified") -- also doubles as the NOREPLY sender-profile address.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=notifications@hantios.com

# Module 33 Session 4B -- Email Conversation Sync (inbound). Both optional/
# fail-soft: absent means the inbound webhook route (POST /api/webhooks/
# resend-inbound) rejects every request with 401, and outbound negotiation
# emails simply omit a dedicated reply-to address. RESEND_WEBHOOK_SECRET is
# the Svix signing secret Resend issues once a webhook is registered in its
# dashboard pointing at this app's public URL (Webhooks -> Add Webhook ->
# event "email.received"). RESEND_INBOUND_DOMAIN is the bare domain (no
# local-part, no @) Resend receives mail for -- can be the root domain
# itself if it has a verified inbound MX record (Domains -> your domain ->
# "Receiving" enabled), no dedicated subdomain required. Don't confuse this
# with a Click Tracking subdomain (often literally named "reply") -- that's
# an unrelated Resend feature and has nothing to do with inbound mail.
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_signing_secret
RESEND_INBOUND_DOMAIN=hantios.com
