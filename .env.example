NODE_ENV=development
PORT=3000

# Neon Postgres connection string. Get from the Neon dashboard.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT signing secrets. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=generate-with-openssl-rand-hex-32
JWT_OTP_SECRET=generate-with-openssl-rand-hex-32
JWT_RESET_SECRET=generate-with-openssl-rand-hex-32

# Google OAuth. Get from Google Cloud Console (localhost:3000 was already registered before the hardware failure).
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
CORS_ORIGINS=http://localhost:5173,https://app.example.com

# Base URL used to build links sent in emails (e.g. staff invite accept links).
APP_BASE_URL=https://app.hantios.com

# Hours a staff invite token stays valid before it must be re-issued.
STAFF_INVITE_EXPIRY_HOURS=72

# Hours a signup email-verification link stays valid before it must be re-sent.
EMAIL_VERIFICATION_EXPIRY_HOURS=24
