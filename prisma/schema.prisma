generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model audit_logs {
  id             String     @id
  business_id    String
  user_id        String
  user_name      String
  user_role      String
  action         String
  entity_type    String
  entity_id      String
  before_state   Json?
  after_state    Json?
  reason         String
  ip_address     String?
  user_agent     String?
  correlation_id String?
  created_at     DateTime   @default(now())
  businesses     businesses @relation(fields: [business_id], references: [id])
  users          users      @relation(fields: [user_id], references: [id])

  @@index([business_id, created_at])
  @@index([business_id, entity_type, entity_id])
  @@index([business_id])
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model branch_inventory {
  id                     String     @id
  business_id            String
  branch_id              String
  product_id             String
  size                   String?
  quantity               Decimal    @default(0) @db.Decimal(14, 2)
  last_updated           DateTime   @default(now())
  version                Int        @default(0)
  // Low Stock Alert debounce (Module 02) -- persisted per-row state, not a
  // query against event/audit history, so a notification fires exactly once
  // per low-stock episode. Written atomically in the SAME transaction as the
  // quantity change that crosses the threshold, so this half is never wrong
  // or duplicated -- only the notification delivery itself (fire-and-forget,
  // after commit) is best-effort. See CLAUDE.md for the full tradeoff.
  low_stock_alert_active Boolean    @default(false)
  low_stock_alerted_at   DateTime?
  branches               branches   @relation(fields: [branch_id], references: [id])
  businesses             businesses @relation(fields: [business_id], references: [id])
  products               products   @relation(fields: [product_id], references: [id])

  @@unique([branch_id, product_id, size])
  @@index([business_id])
}

model branches {
  id                               String                  @id
  business_id                      String
  name                             String
  location                         String?
  manager_id                       String?
  status                           RecordStatus            @default(active)
  created_at                       DateTime                @default(now())
  branch_inventory                 branch_inventory[]
  businesses                       businesses              @relation(fields: [business_id], references: [id])
  users_branches_manager_idTousers users?                  @relation("branches_manager_idTousers", fields: [manager_id], references: [id])
  debts                            debts[]
  expenses                         expenses[]
  inventory_adjustments            inventory_adjustments[]
  sales                            sales[]
  users_users_branch_idTobranches  users[]                 @relation("users_branch_idTobranches")

  @@index([business_id])
}

model businesses {
  id                                  String                  @id
  name                                String
  owner_id                            String?                 @unique
  plan                                String
  tier                                String
  country                             String
  phone_prefix                        String
  country_locked_at                   DateTime?
  timezone                            String
  // Business Day config (Session 3B) -- the single source of truth for Void/Refund
  // eligibility (never server/UTC midnight). Defaults reproduce the already-locked
  // "same calendar day in Business.timezone" rule exactly (every timestamp's local
  // time-of-day is >= 00:00:00). business_day_end_time is stored for future use
  // (Daily Reports/Cash Closing/Shift Closing) but not yet read by Void/Refund --
  // those only need the rolling-24h start boundary, see src/lib/businessTime.ts.
  business_day_start_time             DateTime                @default(dbgenerated("'00:00:00'::time")) @db.Time
  business_day_end_time               DateTime                @default(dbgenerated("'23:59:59'::time")) @db.Time
  currency                            String
  decimal_places                      Int                     @default(2)
  language                            String                  @default("en")
  fiscal_year_start_month             Int                     @default(1)
  fiscal_year_start_day               Int                     @default(1)
  settings                            Json                    @default("{}")
  created_at                          DateTime                @default(now())
  updated_at                          DateTime                @updatedAt
  audit_logs                          audit_logs[]
  branch_inventory                    branch_inventory[]
  branches                            branches[]
  users_businesses_owner_idTousers    users?                  @relation("businesses_owner_idTousers", fields: [owner_id], references: [id])
  categories                          categories[]
  customers                           customers[]
  debts                               debts[]
  debt_payments                       debt_payments[]
  debt_reminders                      debt_reminders[]
  debt_transactions                   debt_transactions[]
  expenses                            expenses[]
  expense_categories                  expense_categories[]
  expense_counters                    expense_counters?
  expense_attachments                 expense_attachments[]
  expense_recurrence                  expense_recurrence[]
  tags                                tags[]
  idempotency_keys                    idempotency_keys[]
  inventory_adjustments               inventory_adjustments[]
  login_events                        login_events[]
  otp_challenges                      otp_challenges[]
  payment_methods                     payment_methods[]
  price_history                       price_history[]
  products                            products[]
  receipt_counters                    receipt_counters[]
  sales                               sales[]
  sessions                            sessions[]
  staff_invites                       staff_invites[]
  users_users_business_idTobusinesses users[]                 @relation("users_business_idTobusinesses")
  warehouse_stock                     warehouse_stock[]
  warehouses                          warehouses?
}

model categories {
  id               String       @id
  business_id      String
  parent_id        String?
  name             String
  created_at       DateTime     @default(now())
  businesses       businesses   @relation(fields: [business_id], references: [id])
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id])
  other_categories categories[] @relation("categoriesTocategories")
  products         products[]

  @@index([business_id])
}

model customers {
  id           String       @id
  business_id  String
  phone        String
  name         String?
  email        String?
  total_spent  Decimal      @default(0) @db.Decimal(14, 2)
  // Derived cache only, kept in sync for cheap reads (CRM dashboards, customer
  // lists, search) -- debts/debt_payments are always the source of truth. If
  // this is ever found to have drifted, recalculate it from those two tables;
  // never trust it over them.
  debt_balance Decimal      @default(0) @db.Decimal(14, 2)
  status       RecordStatus @default(active)
  created_at   DateTime     @default(now())
  businesses   businesses   @relation(fields: [business_id], references: [id])
  debts        debts[]

  @@unique([business_id, phone])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model debts {
  id                       String              @id
  business_id              String
  branch_id                String?
  // customer_id is the real relationship (Session 4); the three fields below
  // are an immutable snapshot taken at creation time -- preserves historical
  // accuracy on this debt even if the customer's own record changes later.
  customer_id              String
  customer_phone           String
  customer_name            String?
  customer_location        String?
  amount_original          Decimal             @db.Decimal(14, 2)
  amount_paid              Decimal             @default(0) @db.Decimal(14, 2)
  amount_remaining         Decimal             @db.Decimal(14, 2)
  date_taken               DateTime            @db.Date
  date_due                 DateTime            @db.Date
  // Interest policy is a snapshot copied from Business.settings at creation
  // time (getDebtInterestPolicy, businessSettings.ts) -- exactly the same
  // "lock it in at the moment it mattered" pattern Sales already uses for
  // costPriceAtSale. Never re-read live from settings at calculation time: a
  // business changing its policy later must only affect debts created after
  // the change, never retroactively change what's owed on an existing debt.
  interest_enabled         Boolean             @default(false)
  interest_type            InterestType        @default(none)
  interest_value           Decimal?            @db.Decimal(14, 2)
  calculation_policy       CalculationPolicy   @default(one_time)
  formula                  InterestFormula     @default(simple)
  percentage_base          PercentageBase      @default(remaining_balance)
  // Null until the first applyInterest call. Drives both period-elapsed math
  // for recurring policies and the one_time "only ever once" guard.
  last_interest_applied_at DateTime?
  notes                    String?
  // Sole source of truth for lifecycle state (Session 4) -- the standalone
  // `disputed` boolean this table used to also carry was dropped as a
  // redundant second copy of what `status: disputed` already means.
  status                   DebtStatus          @default(open)
  created_at               DateTime            @default(now())
  sale_id                  String?
  version                  Int                 @default(0)
  customers                customers           @relation(fields: [customer_id], references: [id])
  branches                 branches?           @relation(fields: [branch_id], references: [id])
  businesses               businesses          @relation(fields: [business_id], references: [id])
  sales                    sales?              @relation(fields: [sale_id], references: [id])
  debt_payments            debt_payments[]
  debt_reminders           debt_reminders[]
  debt_transactions        debt_transactions[]

  @@index([business_id, date_due])
  @@index([business_id])
  @@index([business_id, status])
  @@index([customer_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model debt_payments {
  id                     String           @id
  business_id            String
  debt_id                String
  amount                 Decimal          @db.Decimal(14, 2)
  payment_method_id      String?
  payment_date           DateTime         @db.Date
  notes                  String?
  created_by             String
  // A reversal is a NEW row with a negative amount referencing the original --
  // never an in-place edit or a hard delete (debt records are financial
  // history, kept forever). Mirrors exactly how Session 3B modeled Refund as
  // a new, negated Sale row rather than mutating the original.
  reversal_of_payment_id String?
  version                Int              @default(0)
  created_at             DateTime         @default(now())
  updated_at             DateTime         @updatedAt
  debts                  debts            @relation(fields: [debt_id], references: [id])
  businesses             businesses       @relation(fields: [business_id], references: [id])
  payment_methods        payment_methods? @relation(fields: [payment_method_id], references: [id])
  users                  users            @relation(fields: [created_by], references: [id])
  debt_payments          debt_payments?   @relation("debt_payments_reversal", fields: [reversal_of_payment_id], references: [id])
  other_debt_payments    debt_payments[]  @relation("debt_payments_reversal")

  @@index([business_id])
  @@index([debt_id])
}

// Scheduler idempotency (Session 4 extension) -- @@unique below is the real
// guard, enforced by the DB, not application logic: a claim INSERT here is
// the atomic "has this exact debt+type+day already been handled" check.
// Concurrent scheduler ticks, multiple server instances, and a manual click
// racing an automatic send all collide on the same constraint and can never
// produce two real sends for the same (debt, type, business day).
model debt_reminders {
  id            String         @id
  business_id   String
  debt_id       String
  reminder_type ReminderType
  status        ReminderStatus
  provider      String
  error         String?
  sent_at       DateTime?
  next_retry    DateTime?
  // The business-local calendar date (getBusinessDay) this reminder logically
  // belongs to -- not the row's own created_at, which is a real timestamp and
  // wouldn't dedupe correctly across a business-day boundary that doesn't
  // align with UTC midnight.
  business_date DateTime       @db.Date
  created_at    DateTime       @default(now())
  debts         debts          @relation(fields: [debt_id], references: [id])
  businesses    businesses     @relation(fields: [business_id], references: [id])

  @@unique([debt_id, reminder_type, business_date])
  @@index([business_id])
  @@index([debt_id])
}

// Session 4 extension: immutable interest ledger. Structured (typed) columns
// rather than a JSON blob specifically so Reports/Analytics/BI/Accounting can
// query this directly with plain SQL -- the same structured-over-JSON
// reasoning already applied to debt_payments/debt_reminders. Built against a
// general-purpose DebtTransactionType (see its own comment) but this session
// only ever writes interest_applied rows -- payment/payment_reversal/
// write_off/refund/discount/debt_created stay exactly where Session 4 already
// correctly put them (debt_payments, audit_logs), not migrated here.
// Never updated or deleted, same rule as audit_logs -- no update/delete code
// path should ever be written for this model.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model debt_transactions {
  id                    String              @id
  business_id           String
  debt_id               String
  transaction_type      DebtTransactionType
  amount                Decimal             @db.Decimal(14, 2)
  // The resulting debts.amount_remaining immediately after this entry --
  // history is reconstructable without recomputing from scratch.
  balance_after         Decimal             @db.Decimal(14, 2)
  // Populated on interest_applied/interest_adjustment rows only -- the exact
  // policy values used for THIS calculation (independent of whatever the
  // debt's own snapshot says now, though today they're always identical since
  // debts never change policy after creation -- this makes the ledger
  // self-contained regardless).
  interest_type         InterestType?
  interest_formula      InterestFormula?
  percentage_base       PercentageBase?
  calculation_policy    CalculationPolicy?
  interest_rate_applied Decimal?            @db.Decimal(14, 2)
  periods_elapsed       Int?
  notes                 String?
  created_by            String
  created_at            DateTime            @default(now())
  debts                 debts               @relation(fields: [debt_id], references: [id])
  businesses            businesses          @relation(fields: [business_id], references: [id])
  users                 users               @relation(fields: [created_by], references: [id])

  @@index([business_id])
  @@index([debt_id])
}

// Session 5A (Expenses) -- reshaped from its prior thin shape (plain string
// category, JSON attachments, no version/payment_method_id/expense_number/
// currency-snapshot/vendor fields). Confirmed zero live rows before this
// reshape (no service/controller ever wrote to this table), so this is a
// clean replacement, not a migration of real data. `approved_by` and the old
// JSON `attachments` column are dropped -- both confirmed dormant (grep found
// zero reads/writes anywhere in src/); no approval workflow was asked for
// this session (that's Session 5B's separate workflowStatus field, NOT this
// table's `status`, which stays archive/restore only).
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model expenses {
  id                                String                @id
  business_id                       String
  branch_id                         String?
  scope                             ExpenseScope
  category_id                       String
  // Snapshot, same reasoning as debts.customer_name -- historical accuracy
  // even if the category is later renamed.
  category_name                     String
  amount                            Decimal               @db.Decimal(14, 2)
  // Snapshotted from Business.currency (+ src/lib/currencyReference.ts's
  // getCurrency()) at creation time, same pattern as costPriceAtSale --
  // fields only, no conversion logic (Module 19's job).
  currency_code                     String?
  currency_symbol                   String?
  // Tax Snapshot -- same "fields only, no calculation logic" pattern as the
  // currency snapshot above: manually entered per expense, never derived
  // from amount/rate or vice versa. A real Tax Engine (auto-calculation,
  // tax-code lookup) is a later phase's job, not built here.
  tax_amount                        Decimal?              @db.Decimal(14, 2)
  tax_rate                          Decimal?              @db.Decimal(5, 2)
  tax_included                      Boolean?
  payment_method_id                 String?
  // "When it happened" (renamed from the old `date` column) vs recorded_at
  // "when entered" -- two separate fields, per spec.
  expense_date                      DateTime              @db.Date
  recorded_at                       DateTime              @default(now())
  // NOT a real FK yet -- no vendors/suppliers table exists anywhere in this
  // schema (confirmed). Becomes a real relation once that module ships.
  vendor_id                         String?
  vendor_name                       String?
  reference_number                  String?
  description                       String?
  notes                             String?
  source                            ExpenseSource         @default(manual)
  // Session 5B: workflow_status is the sole source of truth for "is this
  // recurring" going forward -- an expense_recurrence row referencing this
  // expense as its template answers that, structurally, so the old
  // recurring/recurrence_rule (free-text) fields were dropped rather than
  // kept alongside the new table (confirmed zero live rows before dropping).
  workflow_status                   ExpenseWorkflowStatus @default(pending)
  approved_by                       String?
  approved_at                       DateTime?
  rejected_by                       String?
  rejected_at                       DateTime?
  paid_by                           String?
  paid_at                           DateTime?
  created_by                        String
  // Unique PER BUSINESS, not globally -- expense_counters resets each
  // business to its own 1-based sequence, so "EXP-000001" legitimately
  // recurs across different businesses. A bare @unique here was a real bug
  // (caught by the cross-business test suite): the second business's first
  // expense would collide with the first business's own "EXP-000001".
  expense_number                    String
  version                           Int                   @default(0)
  status                            RecordStatus          @default(active)
  archived_reason                   String?
  created_at                        DateTime              @default(now())
  businesses                        businesses            @relation(fields: [business_id], references: [id])
  branches                          branches?             @relation(fields: [branch_id], references: [id])
  expense_categories                expense_categories    @relation(fields: [category_id], references: [id])
  payment_methods                   payment_methods?      @relation(fields: [payment_method_id], references: [id])
  // Four distinct relations to `users` now (created/approved/rejected/paid)
  // -- Prisma requires every one of them named once a model has more than
  // one relation to the same target, same shape sales.confirmed_by already
  // established (users_sales_confirmed_byTousers).
  users_expenses_created_byTousers  users                 @relation("expenses_created_byTousers", fields: [created_by], references: [id])
  users_expenses_approved_byTousers users?                @relation("expenses_approved_byTousers", fields: [approved_by], references: [id])
  users_expenses_rejected_byTousers users?                @relation("expenses_rejected_byTousers", fields: [rejected_by], references: [id])
  users_expenses_paid_byTousers     users?                @relation("expenses_paid_byTousers", fields: [paid_by], references: [id])
  expense_attachments               expense_attachments[]
  expense_recurrence                expense_recurrence?
  expense_tags                      expense_tags[]

  @@unique([business_id, expense_number])
  @@index([business_id, branch_id])
  @@index([business_id, category_id])
  @@index([business_id, expense_date])
  @@index([business_id, workflow_status])
  @@index([business_id])
}

model expense_categories {
  id          String              @id
  business_id String
  name        String
  type        ExpenseCategoryType
  color       String?
  active      Boolean             @default(true)
  created_at  DateTime            @default(now())
  businesses  businesses          @relation(fields: [business_id], references: [id])
  expenses    expenses[]

  @@unique([business_id, name])
  @@index([business_id])
}

// Flat per-business sequence (EXP-000001) -- no year dimension, unlike
// receipt_counters (Sales' INV-<year>-###### is a genuinely different shape;
// see src/lib/expenseNumber.ts for why this isn't a generalization of
// getNextReceiptNumber).
model expense_counters {
  id          String     @id
  business_id String     @unique
  last_number Int        @default(0)
  businesses  businesses @relation(fields: [business_id], references: [id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model expense_attachments {
  id          String     @id
  business_id String
  expense_id  String
  filename    String
  mime_type   String
  size        Int
  // Opaque, client-supplied reference string -- this session builds the
  // metadata table only, not real file-byte storage/upload wiring (no
  // StorageProvider exists anywhere in this repo despite CLAUDE.md's roadmap
  // entry claiming otherwise -- confirmed absent via full-text search).
  storage_key String
  uploaded_by String
  created_at  DateTime   @default(now())
  expenses    expenses   @relation(fields: [expense_id], references: [id])
  businesses  businesses @relation(fields: [business_id], references: [id])
  users       users      @relation(fields: [uploaded_by], references: [id])

  @@index([expense_id])
  @@index([business_id])
}

// Session 5B. Architecture-only -- no scheduler exists yet to actually
// generate new expenses from this schedule (same "ready but not automated"
// boundary the Debt Reminder Scheduler used correctly before it was built).
// One schedule per template expense (@unique) -- to change frequency/
// interval, update this row, not create a second one. `interval` expresses
// "every N periods" (every 2 weeks = frequency: weekly, interval: 2). When a
// real scheduler eventually reads this table and generates a new expense,
// it should audit-log that generation as "expense.recurring_generated" --
// no such action is written by any code path yet.
model expense_recurrence {
  id                  String              @id
  business_id         String
  template_expense_id String              @unique
  frequency           RecurrenceFrequency
  interval            Int                 @default(1)
  next_run            DateTime?           @db.Date
  last_run            DateTime?           @db.Date
  active              Boolean             @default(true)
  created_at          DateTime            @default(now())
  businesses          businesses          @relation(fields: [business_id], references: [id])
  expenses            expenses            @relation(fields: [template_expense_id], references: [id])

  @@index([business_id])
}

// Session 5B. The first true many-to-many relation in this schema (checked:
// every existing "many" relation elsewhere -- categories/sales/users/
// debt_payments self-relations -- is one-to-many via a plain FK, not a real
// junction table). Filter-only, deliberately does not replace the required
// Category field on expenses.
model tags {
  id           String         @id
  business_id  String
  name         String
  created_at   DateTime       @default(now())
  businesses   businesses     @relation(fields: [business_id], references: [id])
  expense_tags expense_tags[]

  @@unique([business_id, name])
  @@index([business_id])
}

model expense_tags {
  expense_id String
  tag_id     String
  expenses   expenses @relation(fields: [expense_id], references: [id])
  tags       tags     @relation(fields: [tag_id], references: [id])

  @@id([expense_id, tag_id])
  @@index([tag_id])
}

model idempotency_keys {
  id              String     @id
  business_id     String
  key             String
  endpoint        String
  response_status Int
  response_body   Json
  created_at      DateTime   @default(now())
  businesses      businesses @relation(fields: [business_id], references: [id])

  @@unique([business_id, key, endpoint])
  @@index([business_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_adjustments {
  id                String         @id
  business_id       String
  product_id        String
  branch_id         String
  quantity_before   Decimal        @db.Decimal(14, 2)
  quantity_after    Decimal        @db.Decimal(14, 2)
  adjustment_amount Decimal        @db.Decimal(14, 2)
  adjustment_type   AdjustmentType
  packaging_level   PackagingLevel @default(each)
  reason            String
  adjusted_by       String
  created_at        DateTime       @default(now())
  // Nullable -- only sale/void-type rows populate this. Added Session 3B so a
  // sale-driven inventory movement (and its later void reversal) can be joined
  // directly to the sale that caused it, instead of parsing the `reason` string.
  sale_id           String?
  users             users          @relation(fields: [adjusted_by], references: [id])
  branches          branches       @relation(fields: [branch_id], references: [id])
  businesses        businesses     @relation(fields: [business_id], references: [id])
  products          products       @relation(fields: [product_id], references: [id])
  sales             sales?         @relation(fields: [sale_id], references: [id])

  @@index([business_id, branch_id])
  @@index([business_id, created_at])
  @@index([business_id])
  @@index([business_id, product_id])
  @@index([sale_id])
}

model login_events {
  id             String      @id
  business_id    String?
  user_id        String?
  email          String
  success        Boolean
  method         String
  ip_address     String?
  user_agent     String?
  device_id      String?
  suspicious     Boolean     @default(false)
  failure_reason String?
  created_at     DateTime    @default(now())
  businesses     businesses? @relation(fields: [business_id], references: [id])
  users          users?      @relation(fields: [user_id], references: [id])

  @@index([business_id])
  @@index([user_id])
}

model otp_challenges {
  id           String     @id
  business_id  String
  user_id      String
  code_hash    String
  attempts     Int        @default(0)
  max_attempts Int        @default(5)
  expires_at   DateTime
  consumed_at  DateTime?
  created_at   DateTime   @default(now())
  purpose      OtpPurpose
  businesses   businesses @relation(fields: [business_id], references: [id])
  users        users      @relation(fields: [user_id], references: [id])

  @@index([business_id])
  @@index([user_id])
}

model password_history {
  id            String   @id
  user_id       String
  password_hash String
  created_at    DateTime @default(now())
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
}

model payment_methods {
  id             String          @id
  business_id    String
  name           String
  logo_url       String?
  account_number String?
  description    String?
  status         RecordStatus    @default(active)
  created_at     DateTime        @default(now())
  businesses     businesses      @relation(fields: [business_id], references: [id])
  sales          sales[]
  debt_payments  debt_payments[]
  expenses       expenses[]

  @@index([business_id])
}

model price_history {
  id          String     @id
  business_id String
  product_id  String
  old_price   Decimal    @db.Decimal(14, 2)
  new_price   Decimal    @db.Decimal(14, 2)
  changed_by  String
  changed_at  DateTime   @default(now())
  reason      String
  businesses  businesses @relation(fields: [business_id], references: [id])
  users       users      @relation(fields: [changed_by], references: [id])
  products    products   @relation(fields: [product_id], references: [id])

  @@index([business_id])
}

model products {
  id                    String                  @id
  business_id           String
  name                  String
  sku                   String?
  barcode               String?
  category_id           String?
  cost_price            Decimal                 @db.Decimal(14, 2)
  selling_price         Decimal                 @db.Decimal(14, 2)
  sizes                 Json                    @default("[]")
  unit_type             String                  @default("each")
  packaging_hierarchy   Json                    @default("{}")
  min_stock_level       Decimal?                @db.Decimal(14, 2)
  images                Json                    @default("[]")
  status                RecordStatus            @default(active)
  version               Int                     @default(0)
  created_at            DateTime                @default(now())
  updated_at            DateTime                @updatedAt
  branch_inventory      branch_inventory[]
  inventory_adjustments inventory_adjustments[]
  price_history         price_history[]
  businesses            businesses              @relation(fields: [business_id], references: [id])
  categories            categories?             @relation(fields: [category_id], references: [id])
  warehouse_stock       warehouse_stock[]

  @@index([business_id, barcode])
  @@index([business_id, created_at])
  @@index([business_id])
  @@index([business_id, sku])
  @@index([business_id, status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sales {
  id                              String                  @id
  business_id                     String
  branch_id                       String
  cashier_id                      String
  customer_phone                  String?
  items                           Json
  subtotal                        Decimal                 @db.Decimal(14, 2)
  discount                        Decimal                 @default(0) @db.Decimal(14, 2)
  discount_type                   DiscountType?
  tax_amount                      Decimal                 @default(0) @db.Decimal(14, 2)
  fee_amount                      Decimal                 @default(0) @db.Decimal(14, 2)
  total                           Decimal                 @db.Decimal(14, 2)
  payment_method_id               String?
  payment_reference               String?
  confirmed_by                    String?
  profit                          Decimal                 @db.Decimal(14, 2)
  receipt_id                      String?
  status                          SaleStatus              @default(completed)
  void_reason                     String?
  timestamp                       DateTime                @default(now())
  refund_of_sale_id               String?
  version                         Int                     @default(0)
  debts                           debts[]
  inventory_adjustments           inventory_adjustments[]
  branches                        branches                @relation(fields: [branch_id], references: [id])
  businesses                      businesses              @relation(fields: [business_id], references: [id])
  users_sales_cashier_idTousers   users                   @relation("sales_cashier_idTousers", fields: [cashier_id], references: [id])
  users_sales_confirmed_byTousers users?                  @relation("sales_confirmed_byTousers", fields: [confirmed_by], references: [id])
  payment_methods                 payment_methods?        @relation(fields: [payment_method_id], references: [id])
  sales                           sales?                  @relation("salesTosales", fields: [refund_of_sale_id], references: [id])
  other_sales                     sales[]                 @relation("salesTosales")

  @@index([business_id, branch_id])
  @@index([business_id])
  @@index([business_id, status])
  @@index([business_id, timestamp])
}

