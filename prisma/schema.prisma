  users             users           @relation(fields: [created_by], references: [id])

  @@index([purchase_order_id])
}

// One immutable snapshot per ACCEPTED proposal (not just a single "final"
// one) -- keyed by negotiation_round, consistent with this repo's "keep
// every entry, never just the latest" ledger philosophy (debt_transactions,
// warehouse_movements). items_snapshot is JSON, matching sales.items' own
// "locked historical snapshot" precedent -- a point-in-time record, never a
// live-queryable structure. This is the permanent legal record of what both
// parties agreed to; future PO edits must never overwrite it.
model po_negotiation_agreement_snapshots {
  id                       String                   @id
  business_id              String
  purchase_order_id        String
  proposal_id              String
  negotiation_round        Int
  items_snapshot           Json
  shipping_method          String?
  delivery_date            DateTime?
  total_expected_value     Decimal                  @db.Decimal(14, 2)
  accepted_at              DateTime                 @default(now())
  accepted_by              String
  purchase_orders          purchase_orders          @relation(fields: [purchase_order_id], references: [id])
  businesses               businesses               @relation(fields: [business_id], references: [id])
  po_negotiation_proposals po_negotiation_proposals @relation(fields: [proposal_id], references: [id])
  users                    users                    @relation(fields: [accepted_by], references: [id])
  po_proforma_invoices     po_proforma_invoices[]

  @@index([purchase_order_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sales {
  id                              String                  @id
  business_id                     String
  branch_id                       String
  cashier_id                      String
  customer_phone                  String?
  // Module 05: real relationship key (never phone, per the merge-ready
  // architecture requirement) -- nullable, since customerPhone itself stays
  // optional. Populated via the shared findOrCreateCustomer whenever a sale
  // is created with a customerPhone; null forever for anonymous sales.
  customer_id                     String?
  items                           Json
  subtotal                        Decimal                 @db.Decimal(14, 2)
  discount                        Decimal                 @default(0) @db.Decimal(14, 2)
  discount_type                   DiscountType?
  tax_amount                      Decimal                 @default(0) @db.Decimal(14, 2)
  fee_amount                      Decimal                 @default(0) @db.Decimal(14, 2)
  total                           Decimal                 @db.Decimal(14, 2)
  payment_method_id               String?
  payment_reference               String?
  confirmed_by                    String?
  profit                          Decimal                 @db.Decimal(14, 2)
  receipt_id                      String?
  status                          SaleStatus              @default(completed)
  void_reason                     String?
  timestamp                       DateTime                @default(now())
  refund_of_sale_id               String?
  version                         Int                     @default(0)
  debts                           debts[]
  inventory_adjustments           inventory_adjustments[]
  branches                        branches                @relation(fields: [branch_id], references: [id])
  businesses                      businesses              @relation(fields: [business_id], references: [id])
  users_sales_cashier_idTousers   users                   @relation("sales_cashier_idTousers", fields: [cashier_id], references: [id])
  users_sales_confirmed_byTousers users?                  @relation("sales_confirmed_byTousers", fields: [confirmed_by], references: [id])
  payment_methods                 payment_methods?        @relation(fields: [payment_method_id], references: [id])
  sales                           sales?                  @relation("salesTosales", fields: [refund_of_sale_id], references: [id])
  other_sales                     sales[]                 @relation("salesTosales")
  customers                       customers?              @relation(fields: [customer_id], references: [id])
  // Module 06 (Receipt System) -- a sale can be the source of at most one
  // receipt (Sale type) and, separately, its OWN reversal row (a distinct
  // sales.id) can be the source of at most one more (Refund type) -- see
  // receipts.sale_id's own comment for why one column safely covers both.
  receipts                        receipts[]

  @@index([business_id, branch_id])
  @@index([business_id])
  @@index([business_id, status])
  @@index([business_id, timestamp])
  @@index([customer_id])
}

