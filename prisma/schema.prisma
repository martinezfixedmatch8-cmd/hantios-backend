}

// One row per outbound email SEND ATTEMPT (a retry updates the SAME row --
// attempt_count increments in place, see src/notifications/emailDelivery.ts
// -- never a second row for the same logical send). Deliberately does NOT
// persist the rendered body: several current call sites embed a one-time
// verification/invite token directly in the body text, and unlike
// otp_challenges/staff_invites this table has no expiry/rotation of its
// own, so storing the body here would create a second, longer-lived place
// those tokens sit. subject is safe to keep (no token ever appears in a
// subject line today) and is what actually helps debug a delivery problem.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model email_send_log {
  id                  String               @id
  business_id         String
  category            NotificationCategory
  sender_profile      SenderProfile
  to_email            String
  from_email          String
  subject             String
  status              EmailStatus          @default(queued)
  // Which EmailProvider implementation handled this send ("resend" |
  // "console") -- future-proofs multi-provider scenarios (Session 7+).
  provider            String
  provider_message_id String?
  attempt_count       Int                  @default(0)
  last_attempt_at     DateTime?
  sent_at             DateTime?
  // Always null this session -- Resend's synchronous send response only
  // confirms acceptance, never actual delivery; real delivery confirmation
  // needs webhook infrastructure (Session 4B/7 territory), not built here.
  // Kept as a real column now so wiring it up later is an UPDATE, not a
  // migration.
  delivered_at        DateTime?
  failure_reason      String?
  created_at          DateTime             @default(now())
  businesses          businesses           @relation(fields: [business_id], references: [id])

  @@index([business_id, created_at])
  @@index([status])
}

// Module 33 Session 4B -- Email Conversation Sync (inbound).
//
// The single atomic dedup gate for Lock #5 (webhook idempotency MUST be
// transaction-safe, never in-memory): one row per Resend email_id EVER
// received, claimed via an atomic create()-catch-P2002 as the FIRST write
// inside the SAME transaction that (conditionally) creates the resulting
// po_negotiation_messages row or unmatched_inbound_emails row -- never a
// separate, earlier transaction (that would reopen exactly the "claimed
// but nothing was ever created" gap Lock #9 warns about). A redelivered
// webhook for an already-claimed email_id is a pure no-op, checked before
// any matching/verification logic runs at all. Deliberately minimal --
// this table's only job is "have we seen this email_id before," not a
// general audit trail (that's what audit_logs / the domain events already
// published from this flow are for).
model resend_inbound_claims {
  id              String   @id
  resend_email_id String   @unique
  claimed_at      DateTime @default(now())
}

// Lock #10's stated priority ("Correct PO > Correct Supplier > Correct
// Tenant > Message Creation") made concrete: every inbound email that
// can't be matched with certainty lands here instead of ever touching
// po_negotiation_messages -- a reviewable record of "emails that didn't
// make it in," never a silent drop. business_id is deliberately nullable:
// several rejection reasons (invalid signature, no correlation match at
// all) may never resolve a business at all.
enum UnmatchedInboundEmailReason {
  sender_not_recognized
  thread_not_found
  parse_error
  signature_invalid
}

model unmatched_inbound_emails {
  id              String                      @id
  resend_email_id String                      @unique
  from_address    String
  to_address      String
  subject         String?
  // A short prefix only, never the full body -- same "don't persist more
  // of an untrusted external payload than actually helps debugging"
  // reasoning email_send_log already applies to its own outbound subject-
  // only (never body) logging.
  body_preview    String?
  reason          UnmatchedInboundEmailReason
  business_id     String?
  received_at     DateTime                    @default(now())
  businesses      businesses?                 @relation(fields: [business_id], references: [id])

  @@index([business_id, received_at])
  @@index([reason])
}

// ============================================================================
// Module 06 -- Receipt System (Phase 0 confirmed 2026-08-11)
// ============================================================================
//
// Six confirmed receipt types, one centralized header table (not six
// separate tables, not a polymorphic entity_type/entity_id design -- the
// latter was already explicitly rejected once in this schema, PO
// Negotiation Session 1, for trading away real FK constraints).
//
// Deliberately separate from and coexists with the pre-existing
// sales.receipt_id / receipt_counters / getNextReceiptNumber (Sales'
// own narrower, INV-prefixed mechanism from Session 3A) -- confirmed
// Option A: left completely untouched, treated as legacy. A completed
// Sale now carries two numbers (its old sales.receipt_id and this
// module's own receipt_number); this is a deliberate, confirmed
// coexistence, not an oversight.
enum ReceiptType {
  sale
  refund
  debt_payment
  warehouse_stock_out
  supplier_goods_received
  po_settlement
}

// VOID/REFUND never delete or mutate the historical receipt record --
// only this status field moves. A Refund additionally creates a brand
// new, separate `refund` receipt (see refund_of_receipt_id below); a Void
// creates no new receipt at all (Sale Void itself creates no new
// financial row -- confirmed in Phase 0), it only flips the ORIGINAL
// Sale Receipt's own status here.
enum ReceiptStatus {
  issued
  voided
  refunded
  partially_refunded
}

enum ReceiptDeliveryChannel {
  whatsapp
  pos_print
}

// pending/failed/success only -- delivery here is fully synchronous
// per-attempt (no async queue exists in this repo, same "not a queue"
// reasoning Module 33's own retry-once already applies), so "pending" is
// a real but extremely short-lived state, not evidence of a worker
// architecture that doesn't exist.
enum ReceiptDeliveryStatus {
  pending
  success
  failed
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model receipts {
  id                        String                      @id
  business_id               String
  // RCP-2026-000001 by default -- ONE shared sequence across all six
  // receipt types per (business, year), confirmed. Prefix is read fresh
  // from Business.settings at generation time (never stored on the
  // counter row), which is what makes a later prefix change never reset
  // the sequence -- see receiptNumberCounter.ts.
  receipt_number            String
  receipt_type              ReceiptType
  status                    ReceiptStatus               @default(issued)
  // Sparse nullable source-event FKs -- exactly ONE populated per row,
  // matching receipt_type. Validated at the Zod/service layer (mirrors PO
  // Negotiation Attachments' own message_id?/proposal_id? XOR pattern)
  // AND backed by a real DB CHECK (chk_receipts_exactly_one_source,
  // num_nonnulls(...) = 1) -- never trusted at only one layer.
  //
  // 🔒 CRITICAL: per-source-event uniqueness (at most one receipt per
  // source row) is NOT expressed as a Prisma @@unique here -- a composite
  // unique spanning sparse nullable columns would never actually catch a
  // duplicate (Postgres treats NULL <> NULL even inside a multi-column
  // unique index, so two rows sharing the same sale_id but both NULL on
  // every other source column would NOT collide). The real guard is 5
  // hand-added PARTIAL unique indexes in the migration SQL, one per
  // source column, each `WHERE <column> IS NOT NULL`. See the migration
  // file itself for the exact DDL -- this is the single most important
  // integrity guarantee in this table and it lives in raw SQL, not here.
  sale_id                   String?
  debt_payment_id           String?
  warehouse_movement_id     String?
  goods_received_note_id    String?
  purchase_order_payment_id String?
  // Set only on a `refund` receipt, pointing back at the ORIGINAL Sale
  // Receipt it corrects. The original is never mutated financially --
  // only its own `status` above moves to refunded/partially_refunded.
  refund_of_receipt_id      String?
  issued_at                 DateTime                    @default(now())
  // Snapshot, not a live read -- a later Business.timezone change must
  // never alter how an already-issued receipt displays its own issuance
  // time (addendum: Business Timezone + UTC).
  business_timezone         String
  currency_code             String
  subtotal                  Decimal                     @db.Decimal(14, 2)
  discount                  Decimal                     @default(0) @db.Decimal(14, 2)
  tax_amount                Decimal                     @default(0) @db.Decimal(14, 2)
  fee_amount                Decimal                     @default(0) @db.Decimal(14, 2)
  total                     Decimal                     @db.Decimal(14, 2)
  // Receipt Language (Business Settings 12.1) -- independent of
  // Business.language (UI language, a separate top-level column).
  // Snapshotted at issuance, never re-read live.
  language                  String
  // Full Receipt Content Completeness snapshot (business logo/name/
  // address, line items incl. size/qty/unit price/line total, subtotal,
  // discount, tax breakdown, fees, total, payment method, currency,
  // language labels) -- the sole source of truth. Rendering must never
  // re-query mutable Sale/Product/Business/Customer records for anything
  // that belongs here.
  snapshot                  Json
  // Versions the SNAPSHOT'S OWN SHAPE, independent of whatever renderer
  // version later formats it -- lets rendering evolve without making a
  // historical receipt dependent on a future rendering change.
  snapshot_version          Int                         @default(1)
  created_by                String
  created_at                DateTime                    @default(now())
  businesses                businesses                  @relation(fields: [business_id], references: [id])
  users                     users                       @relation(fields: [created_by], references: [id])
  sales                     sales?                      @relation(fields: [sale_id], references: [id])
  debt_payments             debt_payments?              @relation(fields: [debt_payment_id], references: [id])
  warehouse_movements       warehouse_movements?        @relation(fields: [warehouse_movement_id], references: [id])
  goods_received_notes      goods_received_notes?       @relation(fields: [goods_received_note_id], references: [id])
  purchase_order_payments   purchase_order_payments?    @relation(fields: [purchase_order_payment_id], references: [id])
  receipts                  receipts?                   @relation("receipts_refund", fields: [refund_of_receipt_id], references: [id])
  other_receipts            receipts[]                  @relation("receipts_refund")
  receipt_delivery_attempts receipt_delivery_attempts[]

  @@unique([business_id, receipt_number])
  @@index([business_id, receipt_type])
  @@index([business_id, issued_at])
  @@index([business_id, status])
}

// Shared (business, year) sequence for ALL six receipt types -- confirmed
// distinct from the pre-existing receipt_counters (Sales-only, INV-
// prefixed). No prefix column here by design: the prefix lives in
// Business.settings and is read fresh at generation time (getReceiptSettings,
// businessSettings.ts), so a business changing its prefix never resets or
// otherwise touches this counter's own last_number. See receiptNumberCounter.ts.
model receipt_number_counters {
  id          String     @id
  business_id String
  year        Int
  last_number Int        @default(0)
  businesses  businesses @relation(fields: [business_id], references: [id])

  @@unique([business_id, year])
  @@index([business_id])
}

// Append-only delivery-attempt log -- one row per REAL attempt, never
// updated in place on retry (deliberately NOT modeled like
// email_send_log's own single-row-plus-attempt_count shape -- the locked
// spec's own example, print -> WhatsApp-fail -> WhatsApp-retry-success,
// needs three genuinely separate, independently-timestamped rows to be
// reconstructable as real history). business_id is duplicated here
// alongside receipt_id per the locked defense-in-depth/tenant-isolation
// requirement, even though it's derivable via the parent receipt.
model receipt_delivery_attempts {
  id             String                 @id
  business_id    String
  receipt_id     String
  // Sequential per receipt (1, 2, 3, ...) -- assigned by the service layer
  // inside a transaction; @@unique below is the real, DB-enforced guard
  // against a concurrent double-assignment, not just a display counter.
  attempt_number Int
  channel        ReceiptDeliveryChannel
  status         ReceiptDeliveryStatus  @default(pending)
  requested_at   DateTime               @default(now())
  completed_at   DateTime?
  failure_reason String?
  requested_by   String
  // WhatsApp-only: the destination customer reference (nullable -- a
  // receipt doesn't always have a known customer) PLUS a snapshotted
  // phone number, mirroring debt.customer_phone's own established
  // "snapshot the phone used for the attempt, never a live customer
  // join" precedent -- a later customer phone-number edit must never
  // silently rewrite what a historical delivery attempt says it sent to.
  customer_id    String?
  phone_snapshot String?
  // POS_PRINT-only: execution context, not an external recipient. No POS
  // terminal/device-ID column -- no such concept exists anywhere in this
  // repo today (confirmed via Phase 0 search); fabricating one here would
  // be inventing infrastructure, not reusing it.
  branch_id      String?
  businesses     businesses             @relation(fields: [business_id], references: [id])
  receipts       receipts               @relation(fields: [receipt_id], references: [id])
  users          users                  @relation(fields: [requested_by], references: [id])
  customers      customers?             @relation(fields: [customer_id], references: [id])
  branches       branches?              @relation(fields: [branch_id], references: [id])

  @@unique([receipt_id, attempt_number])
  @@index([business_id])
  @@index([receipt_id])
}
