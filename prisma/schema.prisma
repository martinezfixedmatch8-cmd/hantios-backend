// Module 11 (Purchase Orders) prerequisite -- built as a full module this
// session (not a bare table) per explicit decision: no dedup/uniqueness
// constraint on phone/name (nothing in the spec asked for supplier dedup,
// unlike Customers' phone-uniqueness requirement), no supplier-number
// sequence (not requested).
model suppliers {
  id                            String                          @id
  business_id                   String
  name                          String
  phone                         String?
  email                         String?
  notes                         String?
  // Session 2A -- the supplier's own default/quoted terms, nullable (didn't
  // exist before this session, so every pre-existing supplier has none
  // configured). Snapshotted onto purchase_orders.payment_terms at PO
  // creation time (same "policy snapshot" pattern as costPriceAtSale/
  // supplier_name_snapshot) -- a later edit here never retroactively
  // changes an already-created PO's own terms.
  payment_terms                 PaymentTerms?
  status                        RecordStatus                    @default(active)
  archived_reason               String?
  version                       Int                             @default(0)
  created_at                    DateTime                        @default(now())
  updated_at                    DateTime                        @updatedAt
  businesses                    businesses                      @relation(fields: [business_id], references: [id])
  purchase_orders               purchase_orders[]
  supplier_payment_instructions supplier_payment_instructions[]

  @@index([business_id, status])
  @@index([business_id, name])
}

enum PaymentTerms {
  prepayment
  net_30
  net_60
  net_90
}

enum PurchaseOrderStatus {
  draft
  sent
  confirmed
  partially_received
  received
  // No "paid" value (Module 11 Session B correction) -- payment is an
  // orthogonal fact tracked by the separate PurchaseOrderPaymentStatus/
  // payment_status below, not a step in this receiving lifecycle. A PO can
  // be `received` (fulfillment complete) while `payment_status: partially_paid`
  // (money side incomplete) simultaneously, which one combined enum could
  // never express -- same "never track one fact two ways" principle that
  // already dropped Debts' redundant `disputed` boolean and Expenses'
  // redundant `recurring` boolean. Session A shipped `paid` here with zero
  // live rows ever using it; safe to remove outright rather than leave a
  // permanently-dead, confusing value.
  cancelled
}

enum PurchaseOrderPaymentStatus {
  unpaid
  partially_paid
  paid
}

enum ThreeWayMatchStatus {
  matched
  match_failed
}

enum WalletNetwork {
  trc20
  erc20
}

// Session 2A -- an invoice's own LIFECYCLE state only (issued vs
// superseded-by-a-reissue). Deliberately does NOT include a "fully
// advanced"/"fully prepaid" value the way an early draft of this session's
// spec suggested -- that's Invoice Payment Status, a separate, PURELY
// DERIVED concept (see computeInvoicePaymentStatus in
// poProformaInvoice.service.ts), never stored here. Keeping status/Payment
// Status as two different fields resolves what would otherwise be tracking
// the same "is this invoice covered" fact in two places at once -- the
// exact principle that already dropped Debts' redundant `disputed` boolean.
enum ProformaInvoiceStatus {
  issued
  superseded
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model purchase_orders {
  id                                 String                               @id
  business_id                        String
  branch_id                          String?
  supplier_id                        String
  // Captured once at creation from the supplier's live values at that
  // moment (and re-captured on any supplierId change while still DRAFT) --
  // a later edit to the live Supplier record must never retroactively
  // change a historical PO. Same principle as costPriceAtSale on Sales.
  supplier_name_snapshot             String
  supplier_phone_snapshot            String?
  supplier_email_snapshot            String?
  // PO-000001, sequential per business, immutable, never reused -- mirrors
  // customerNumber.ts/expenseNumber.ts exactly. See purchaseOrderNumber.ts.
  po_number                          String
  status                             PurchaseOrderStatus                  @default(draft)
  // Fields only, no calculation logic (Module 19's job, not built here) --
  // same "snapshot now, convert later" boundary Expenses' own currency
  // snapshot already established.
  currency_code                      String
  exchange_rate                      Decimal?                             @db.Decimal(14, 6)
  // Derived cache, recomputed and re-persisted at the one place it's
  // actually written (create, and PATCH-while-DRAFT when items are
  // replaced) -- never client-supplied, never trusted blindly, same
  // pattern as customers.total_spent/debts.amount_remaining.
  total_expected_value               Decimal                              @db.Decimal(14, 2)
  cancel_reason                      String?
  // Module 11 Session B -- orthogonal to `status` (see PurchaseOrderStatus's
  // own comment on why "paid" was removed from that enum). remaining_amount
  // is set to total_expected_value at creation (nothing owed until paid) and
  // recomputed at the one place it's written (payPurchaseOrder), same
  // derived-cache pattern as total_expected_value itself.
  payment_status                     PurchaseOrderPaymentStatus           @default(unpaid)
  paid_amount                        Decimal                              @default(0) @db.Decimal(14, 2)
  remaining_amount                   Decimal                              @db.Decimal(14, 2)
  // PO Negotiation Session 1 -- negotiation_round increments once per
  // accepted proposal (never per submit/reject); negotiation_respond_by is
  // an optional owner-set deadline, purely derived-at-read-time expiry (see
  // computeNegotiationStatus in poNegotiation.service.ts), no scheduler.
  negotiation_round                  Int                                  @default(0)
  negotiation_respond_by             DateTime?
  // Module 33 Session 4B -- a stable, cryptographically-random, per-PO
  // correlation token for inbound email reply-matching (src/lib/
  // inboundEmailCorrelation.ts). Deliberately NOT the same token as
  // po_secure_links' own rotatable one: that link can be revoked/
  // regenerated at any time (Session 1's own design), and a reply-to
  // address derived from it would silently orphan an in-flight email
  // thread the moment the owner regenerates the link for an unrelated
  // reason. This token has its own independent lifecycle -- generated
  // once, lazily, on first use, never rotated. Nullable: only populated
  // once an inbound-capable outbound negotiation email has actually been
  // sent (RESEND_INBOUND_DOMAIN configured); most POs in this dev
  // environment will never populate it.
  negotiation_reply_token            String?                              @unique
  // Session 2A -- snapshotted once from suppliers.payment_terms at PO
  // creation time (nullable: a supplier with no configured terms yet, or a
  // PO created before this session existed). A later edit to the supplier's
  // own terms never retroactively changes an already-created PO's terms.
  payment_terms                      PaymentTerms?
  version                            Int                                  @default(0)
  created_by                         String
  created_at                         DateTime                             @default(now())
  updated_at                         DateTime                             @updatedAt
  businesses                         businesses                           @relation(fields: [business_id], references: [id])
  branches                           branches?                            @relation(fields: [branch_id], references: [id])
  suppliers                          suppliers                            @relation(fields: [supplier_id], references: [id])
  users                              users                                @relation(fields: [created_by], references: [id])
  purchase_order_items               purchase_order_items[]
  goods_received_notes               goods_received_notes[]
  purchase_order_payments            purchase_order_payments[]
  expenses                           expenses[]
  po_secure_links                    po_secure_links[]
  po_negotiation_messages            po_negotiation_messages[]
  po_negotiation_proposals           po_negotiation_proposals[]
  po_negotiation_attachments         po_negotiation_attachments[]
  po_negotiation_internal_notes      po_negotiation_internal_notes[]
  po_negotiation_agreement_snapshots po_negotiation_agreement_snapshots[]
  po_proforma_invoices               po_proforma_invoices[]
  po_advance_payments                po_advance_payments[]
  po_commercial_invoices             po_commercial_invoices[]
  po_shipments                       po_shipments[]
  po_delivery_milestones             po_delivery_milestones[]
  po_eta_updates                     po_eta_updates[]

  @@unique([business_id, po_number])
  @@index([business_id, status])
  @@index([business_id, payment_status])
  @@index([business_id])
  @@index([supplier_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model purchase_order_items {
  id                              String                            @id
  business_id                     String
  purchase_order_id               String
  product_id                      String
  // Captured once at creation from the product's live values at that
  // moment -- a later Product price/name change must never retroactively
  // change a historical PO line item. Same principle as costPriceAtSale.
  product_name_snapshot           String
  sku_snapshot                    String?
  quantity_ordered                Decimal                           @db.Decimal(14, 2)
  unit_cost_snapshot              Decimal                           @db.Decimal(14, 2)
  // Stored, computed once at write time (quantityOrdered x unitCostSnapshot)
  // -- mirrors Sales' own stored lineSubtotal precedent rather than
  // deriving it lazily on every read.
  line_total                      Decimal                           @db.Decimal(14, 2)
  created_at                      DateTime                          @default(now())
  purchase_orders                 purchase_orders                   @relation(fields: [purchase_order_id], references: [id])
  businesses                      businesses                        @relation(fields: [business_id], references: [id])
  products                        products                          @relation(fields: [product_id], references: [id])
  goods_received_items            goods_received_items[]
  po_negotiation_proposal_changes po_negotiation_proposal_changes[]
  po_shipment_items               po_shipment_items[]

  @@index([business_id])
  @@index([purchase_order_id])
}

// Purchase Order Number sequence -- mirrors customer_counters/
// expense_counters exactly, no year dimension.
model po_counters {
  id          String     @id
  business_id String     @unique
  last_number Int        @default(0)
  businesses  businesses @relation(fields: [business_id], references: [id])
}

// Module 11 Session B -- Goods Received Note. Immutable once created (no
// update/delete code path, matching inventory_adjustments/audit_logs).
// Multiple GRNs can exist against one PO by design (partial deliveries) --
// nothing here assumes a 1:1 relationship.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model goods_received_notes {
  id                     String                 @id
  business_id            String
  purchase_order_id      String
  // GRN-000001, sequential per business, immutable -- mirrors po_number
  // exactly. See grnNumber.ts.
  grn_number             String
  // Most suppliers issue their own delivery note number -- useful for
  // reconciliation, purely informational, never validated/deduped.
  supplier_delivery_note String?
  // Free-text, client-supplied explanation of any discrepancy -- the
  // discrepancy itself is flagged numerically per line via
  // goods_received_items.variance_quantity, this is just an optional human
  // annotation alongside it.
  variance_notes         String?
  received_by            String
  received_at            DateTime               @default(now())
  purchase_orders        purchase_orders        @relation(fields: [purchase_order_id], references: [id])
  businesses             businesses             @relation(fields: [business_id], references: [id])
  users                  users                  @relation(fields: [received_by], references: [id])
  goods_received_items   goods_received_items[]
  warehouse_movements    warehouse_movements[]
  // Module 06 (Receipt System) -- Supplier Goods Received type.
  receipts               receipts[]

  @@unique([business_id, grn_number])
  @@index([business_id])
  @@index([purchase_order_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model goods_received_items {
  id                   String               @id
  business_id          String
  grn_id               String
  po_item_id           String
  product_id           String
  quantity_received    Decimal              @db.Decimal(14, 2)
  // The actual invoiced/received unit cost -- may legitimately differ from
  // the PO's own negotiated unit_cost_snapshot (supplier substitutions,
  // last-minute pricing changes), never overwrites it.
  unit_cost_actual     Decimal              @db.Decimal(14, 2)
  // Server-computed once at write time (quantity_received - the PO line's
  // quantity_ordered), signed -- positive means over-delivery, negative
  // means under-delivery on THIS GRN specifically. Stored, not derived live,
  // same "derived cache written at the one place it's produced" pattern
  // used throughout this schema.
  variance_quantity    Decimal              @db.Decimal(14, 2)
  created_at           DateTime             @default(now())
  goods_received_notes goods_received_notes @relation(fields: [grn_id], references: [id])
  purchase_order_items purchase_order_items @relation(fields: [po_item_id], references: [id])
  businesses           businesses           @relation(fields: [business_id], references: [id])
  products             products             @relation(fields: [product_id], references: [id])

  @@index([business_id])
  @@index([grn_id])
  @@index([po_item_id])
}

// GRN Number sequence -- mirrors po_counters exactly.
model grn_counters {
  id          String     @id
  business_id String     @unique
  last_number Int        @default(0)
  businesses  businesses @relation(fields: [business_id], references: [id])
}

// Module 11 Session B -- one payment installment against a PO. Immutable
// once created (financial history, no edit/reversal path this session,
// unlike debt_payments which does support reversal). expense_id is NOT
// NULL -- every payment atomically creates its linked Expense in the same
// transaction (createExpenseInTransaction), never as a separate step.
model purchase_order_payments {
  id                    String              @id
  business_id           String
  purchase_order_id     String
  amount                Decimal             @db.Decimal(14, 2)
  invoice_amount        Decimal             @db.Decimal(14, 2)
  invoice_reference     String?
  match_status          ThreeWayMatchStatus
  // Signed variance recorded for audit purposes -- the larger of the two
  // pairwise gaps checked (invoice vs PO expected, cumulative GRN-received
  // value vs PO expected), whichever pushed match_status to match_failed
  // (or the invoice-vs-expected gap when matched).
  match_variance        Decimal             @db.Decimal(14, 2)
  match_overridden      Boolean             @default(false)
  match_override_reason String?
  expense_id            String
  payment_date          DateTime            @db.Date
  notes                 String?
  created_by            String
  created_at            DateTime            @default(now())
  purchase_orders       purchase_orders     @relation(fields: [purchase_order_id], references: [id])
  businesses            businesses          @relation(fields: [business_id], references: [id])
  expenses              expenses            @relation(fields: [expense_id], references: [id])
  users                 users               @relation(fields: [created_by], references: [id])
  // Module 06 (Receipt System) -- PO Settlement type.
  receipts              receipts[]

  @@index([business_id])
  @@index([purchase_order_id])
}

// ============================================================================
// Supplier Payment Instructions + Payment Terms + Proforma Invoice +
// Advance Payments (Session 2A). Payment Instructions is a genuinely new
// table, not a reuse of payment_methods -- confirmed in this session's own
// Phase 0 that payment_methods (Module 07) has no IBAN/SWIFT/beneficiary
// fields, just a business-configured channel label. See CLAUDE.md's
// "Supplier Payments, Advance Payments, Proforma Invoice -- Session 2A"
// section for the full design rationale (why Invoice Payment Status is a
// separate, purely-derived concept from the already-stored, already-live
// purchase_orders.payment_status, and why Proforma falls back to the PO's
// own line items when no Agreement Snapshot exists yet).
// ============================================================================

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model supplier_payment_instructions {
  id                  String                @id
  business_id         String
  supplier_id         String
  beneficiary_name    String
  bank_name           String?
  account_number      String?
  iban                String?
  swift               String?
  wallet_address      String?
  network             WalletNetwork?
  default_currency    String
  // Only one true per supplier at a time -- enforced for real via a raw
  // partial unique index (Postgres has no plain @@unique-among-a-subset
  // syntax in Prisma's DSL, same documented gap as Customer Records'
  // active-only phone uniqueness), not just an app-layer "unset the old one
  // first" convention. See the migration's own hand-added
  // ux_supplier_payment_instructions_one_default index.
  is_default          Boolean               @default(false)
  created_at          DateTime              @default(now())
  created_by          String
  businesses          businesses            @relation(fields: [business_id], references: [id])
  suppliers           suppliers             @relation(fields: [supplier_id], references: [id])
  users               users                 @relation(fields: [created_by], references: [id])
  po_advance_payments po_advance_payments[]

  @@index([business_id])
  @@index([supplier_id])
}

model proforma_invoice_counters {
  id          String     @id
  business_id String     @unique
  last_number Int        @default(0)
  businesses  businesses @relation(fields: [business_id], references: [id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model po_proforma_invoices {
  id                                 String                              @id
  business_id                        String
  purchase_order_id                  String
  // Nullable -- a PO that never entered negotiation (the common case; a PO
  // going straight DRAFT->SENT->CONFIRMED without a supplier counter-offer)
  // has zero po_negotiation_agreement_snapshots rows. Interpretation flagged
  // explicitly (the base spec assumed one always exists): when null, the
  // Proforma is generated directly from the PO's own current line items
  // instead -- a PO the supplier never countered is trivially "agreed" as
  // sent, so its own items ARE the agreed terms by default.
  agreement_snapshot_id              String?
  // PFI-000001, sequential per business -- same atomic-counter shape as
  // po_number/expense_number/customer_number (see proformaInvoiceNumber.ts).
  invoice_number                     String
  subtotal                           Decimal                             @db.Decimal(14, 2)
  shipping_cost                      Decimal                             @default(0) @db.Decimal(14, 2)
  insurance                          Decimal                             @default(0) @db.Decimal(14, 2)
  total                              Decimal                             @db.Decimal(14, 2)
  currency_code                      String
  valid_until                        DateTime
  issued_at                          DateTime                            @default(now())
  issued_by                          String
  // Future PDF generation placeholder, same "dormant, no upload feature
  // yet" pattern as Products' images / Expense Attachments' storage_key.
  storage_key                        String?
  // Lifecycle ONLY (issued/superseded) -- Invoice Payment Status
  // (UNPAID/PARTIALLY_PAID/FULLY_PREPAID) is a separate, purely-derived
  // concept computed at query time, never stored on this field. See the
  // enum's own comment for why these were deliberately kept apart.
  status                             ProformaInvoiceStatus               @default(issued)
  created_at                         DateTime                            @default(now())
  businesses                         businesses                          @relation(fields: [business_id], references: [id])
  purchase_orders                    purchase_orders                     @relation(fields: [purchase_order_id], references: [id])
  po_negotiation_agreement_snapshots po_negotiation_agreement_snapshots? @relation(fields: [agreement_snapshot_id], references: [id])
  users                              users                               @relation(fields: [issued_by], references: [id])
  po_advance_payments                po_advance_payments[]

  @@unique([business_id, invoice_number])
  @@index([purchase_order_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model po_advance_payments {
  id                              String                        @id
  business_id                     String
  purchase_order_id               String
  proforma_invoice_id             String
  amount                          Decimal                       @db.Decimal(14, 2)
  currency_code                   String
  // Fields only, no conversion logic -- same "snapshot now, convert later"
  // boundary Purchase Orders' own exchange_rate and Expenses' currency
  // snapshot already established. Module 19's job, not built here.
  exchange_rate_snapshot          Decimal?                      @db.Decimal(14, 6)
  base_currency                   String?
  supplier_currency               String?
  // Reuses the existing payment_methods table (a business-configured
  // channel label, e.g. "Cash"/"M-Pesa"/"Bank Transfer") exactly the way
  // Sales/DebtPayments/Expenses already do, rather than inventing a new,
  // parallel "method" string enum -- there is no separate channel-type
  // value set anywhere else in this schema to duplicate. Nullable, matching
  // every other optional payment_method_id FK in this repo.
  payment_method_id               String?
  supplier_payment_instruction_id String
  // Snapshotted at write time from the live SupplierPaymentInstruction --
  // same Policy Snapshot pattern as Payment Terms/unitCostSnapshot. If the
  // supplier's bank details change later, historical advance payments keep
  // showing what was actually used at the time.
  beneficiary_name_snapshot       String
  bank_name_snapshot              String?
  account_number_snapshot         String?
  iban_snapshot                   String?
  swift_snapshot                  String?
  wallet_address_snapshot         String?
  network_snapshot                WalletNetwork?
  reference                       String?
  // Free text, e.g. "Deposit 20%", "Second installment" -- display only,
  // never read by any business logic.
  installment_label               String?
  paid_at                         DateTime                      @default(now())
  recorded_by                     String
  created_at                      DateTime                      @default(now())
  businesses                      businesses                    @relation(fields: [business_id], references: [id])
  purchase_orders                 purchase_orders               @relation(fields: [purchase_order_id], references: [id])
  po_proforma_invoices            po_proforma_invoices          @relation(fields: [proforma_invoice_id], references: [id])
  supplier_payment_instructions   supplier_payment_instructions @relation(fields: [supplier_payment_instruction_id], references: [id])
  payment_methods                 payment_methods?              @relation(fields: [payment_method_id], references: [id])
  users                           users                         @relation(fields: [recorded_by], references: [id])

  @@index([purchase_order_id])
  @@index([proforma_invoice_id])
}

// ============================================================================
// Commercial Invoice + full Invoice Payment Status (Session 2B). Finishes
// the "Invoice Split" work Session 2A started -- see CLAUDE.md's own
// "Commercial Invoice + 3-Way Match + Full Payment Status -- Session 2B"
// section for the full design rationale (why the issuance gate is an
// acknowledged interim substitute for a real shipment-status check, why
// 3-way match re-pointing is backward-compatible rather than a breaking
// change to Session B's already-shipped endpoint).
// ============================================================================

enum CommercialInvoiceStatus {
  issued
  superseded
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model commercial_invoice_counters {
  id          String     @id
  business_id String     @unique
  last_number Int        @default(0)
  businesses  businesses @relation(fields: [business_id], references: [id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model po_commercial_invoices {
  id                String                   @id
  business_id       String
  purchase_order_id String
  // CI-000001, sequential per business -- same atomic-counter shape as
  // every other numbered document in this repo.
  invoice_number    String
  total_amount      Decimal                  @db.Decimal(14, 2)
  currency_code     String
  issued_at         DateTime                 @default(now())
  issued_by         String
  // Future PDF generation placeholder, same pattern as Proforma Invoice's
  // own storage_key.
  storage_key       String?
  // Immutable financial document -- corrections are modeled as a NEW row
  // with supersedes_id pointing back to the one it corrects, exactly the
  // same pattern already used for Proforma Invoice re-issuance and Sales
  // Refunds (refund_of_sale_id). Never an in-place PATCH of totals.
  status            CommercialInvoiceStatus  @default(issued)
  supersedes_id     String?
  created_at        DateTime                 @default(now())
  businesses        businesses               @relation(fields: [business_id], references: [id])
  purchase_orders   purchase_orders          @relation(fields: [purchase_order_id], references: [id])
  users             users                    @relation(fields: [issued_by], references: [id])
  supersedes        po_commercial_invoices?  @relation("po_commercial_invoices_supersedes", fields: [supersedes_id], references: [id])
  superseded_by     po_commercial_invoices[] @relation("po_commercial_invoices_supersedes")

  // Future extension point -- NOT built this session: creditNoteId/
  // debitNoteId would attach here once that feature is ever requested.

  @@unique([business_id, invoice_number])
  @@index([purchase_order_id])
}

// ============================================================================
// Shipments, Tracking, Delivery Milestones, ETA (Module 11 Session 3).
// Corrects Session 2B's interim FULLY_PREPAID Commercial Invoice gate with
// the real signal it was always meant to be replaced with -- see CLAUDE.md's
// "Shipments, Tracking, Delivery Milestones -- Module 11 Session 3" section
// for full design rationale (why "who acted" fields reuse PoNegotiationParty
// instead of a users FK, why the Shipment Audit Log requirement is satisfied
// by the existing audit_logs table rather than a new parallel one, why
// over-shipment is hard-blocked unlike GRN's own allow-and-flag precedent).
// ============================================================================

enum ShipmentMethod {
  air
  sea
  courier
}

enum ShipmentTrackingType {
  bill_of_lading
  air_waybill
  container_number
  courier_tracking
}

// Real ICC Incoterms 2020 values -- kept UPPERCASE, a deliberate exception
// to this schema's own snake_case enum convention. Unlike every other enum
// in this codebase (invented internal vocabulary), these are a fixed
// external trade-document standard; lowercasing them would be unrecognizable
// on real customs/freight paperwork, the same reasoning that already keeps
// SWIFT codes and ISO currency codes in their natural uppercase form.
enum Incoterm {
  EXW
  FCA
  FAS
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DPU
  DDP
}

enum ShipmentCostResponsibility {
  buyer
  supplier
  shared
}

// Locked vocabulary (used literally in the Commercial Invoice gate
// condition below) -- deliberately NOT the addendum's own "typical
// shipment timeline" example (Created/Booked/Loaded/Departed/Arrived Port/
// Customs Clearance/Out For Delivery/Delivered). That list is illustrative
// narrative color for the general concept of a status timeline, not a
// competing literal enum -- adopting it verbatim would break the one gate
// condition in this whole session that's explicitly locked and testable
// ("status IN (dispatched, in_transit, arrived, delivered)"). Flagged, not
// silently reconciled.
enum ShipmentStatus {
  pending
  dispatched
  in_transit
  customs
  arrived
  delivered
  delayed
  cancelled
}

enum ShipmentPriority {
  low
  normal
  high
  urgent
}

enum ShipmentCancellationReason {
  supplier_issue
  port_closure
  customer_cancelled
  inventory_issue
  other
}

enum DeliveryMilestoneType {
  production_started
  production_finished
  packing
  ready_to_ship
  shipped
  customs_clearance
  arrived
  warehouse_received
  completed
}

enum EtaReasonCategory {
  weather
  port_congestion
  customs
  carrier_delay
  supplier_delay
  other
}

enum ShipmentAttachmentType {
  packing_list
  bill_of_lading
  air_waybill
  certificate_of_origin
  insurance_certificate
  inspection_certificate
  other
}

model shipment_counters {
  id          String     @id
  business_id String
  year        Int
  last_number Int        @default(0)
  businesses  businesses @relation(fields: [business_id], references: [id])

  @@unique([business_id, year])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model po_shipments {
  id                        String                       @id
  business_id               String
  purchase_order_id         String
  // SHP-2026-000001 -- year-scoped, mirroring receiptNumber.ts's exact
  // (business_id, year) shape, NOT the flat po_number/grn_number sequence --
  // the addendum's own example is year-scoped, unlike every other numbered
  // document in Module 11.
  shipment_number           String
  method                    ShipmentMethod
  carrier                   String?
  tracking_reference        String?
  tracking_type             ShipmentTrackingType?
  container_no              String?
  vessel_or_flight          String?
  port_of_departure         String?
  port_of_arrival           String?
  // Addendum #17 -- a real delivery window, not a single point-in-time ETA.
  expected_arrival_from     DateTime?
  expected_arrival_to       DateTime?
  actual_arrival            DateTime?
  incoterms                 Incoterm?
  // Stored explicitly, only ever DEFAULT-SUGGESTED from incoterms at create
  // time (see suggestCostResponsibility in src/lib/shipmentCostSuggestion.ts)
  // -- never silently re-derived on read, since real contracts routinely
  // deviate from textbook Incoterm cost rules.
  cost_responsibility       ShipmentCostResponsibility?
  shipping_cost             Decimal                      @default(0) @db.Decimal(14, 2)
  insurance                 Decimal                      @default(0) @db.Decimal(14, 2)
  // Addendum #14 -- a SEPARATE business fact from insurance's own monetary
  // amount above. $500 of insurance cost and "who contractually pays it"
  // are never the same fact; never inferred from one another at read time.
  insurance_responsibility  ShipmentCostResponsibility?
  customs_cost              Decimal                      @default(0) @db.Decimal(14, 2)
  customs_notes             String?
  status                    ShipmentStatus               @default(pending)
  priority                  ShipmentPriority             @default(normal)
  // Addendum #15 -- snapshotted once at shipment creation from whichever of
  // branches.location/warehouses.location the PO actually resolves to (this
  // schema has no dedicated structured address entity anywhere) -- a later
  // change to the live branch/warehouse record must never retroactively
  // change a historical shipment's own agreed destination.
  delivery_address_snapshot Json
  // Addendum #20 -- three independent identifiers, never overloaded into
  // one generic "reference" field.
  supplier_reference        String?
  carrier_reference         String?
  customs_reference         String?
  // Addendum #18 -- a cancelled shipment always carries a real reason, never
  // just a bare terminal status.
  cancel_reason             ShipmentCancellationReason?
  cancel_reason_notes       String?
  // Addendum #19 -- logistics proof-of-delivery, a genuinely different
  // business event from GRN's own warehouse-inspection verification. A
  // shipment can be "delivered" before GRN ever runs.
  received_by               String?
  received_at               DateTime?
  receiver_notes            String?
  // "Who created this" reuses PoNegotiationParty exactly like every
  // po_negotiation_* table already does, rather than a users FK -- a
  // shipment can originate from either side (POST /portal/po/:token/
  // shipments exists for the supplier too), and a supplier has no users
  // row anywhere in this schema.
  created_by_party          PoNegotiationParty
  created_by_name           String?
  // Addendum #23 -- optimistic lock, and the mechanism the version-lock
  // rule below is built on: once status reaches delivered/cancelled, every
  // guarded updateMany in this module additionally requires
  // status: {notIn: [delivered, cancelled]} in its own WHERE clause, making
  // the row immutable by construction rather than by a separate check.
  version                   Int                          @default(0)
  created_at                DateTime                     @default(now())
  updated_at                DateTime                     @updatedAt
  purchase_orders           purchase_orders              @relation(fields: [purchase_order_id], references: [id])
  businesses                businesses                   @relation(fields: [business_id], references: [id])
  items                     po_shipment_items[]
  eta_updates               po_eta_updates[]
  milestones                po_delivery_milestones[]
  attachments               po_shipment_attachments[]
  status_history            po_shipment_status_history[]

  @@unique([business_id, shipment_number])
  @@index([purchase_order_id])
}

// LOCKED, the most important addition this session -- structured line
// items per shipment, same principle as goods_received_items. Multiple
// po_shipments rows per PO are expected and normal (partial shipments,
// same precedent as partial GRN) -- deliberately no uniqueness constraint
// assuming one shipment per PO.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model po_shipment_items {
  id                   String               @id
  business_id          String
  shipment_id          String
  po_item_id           String
  quantity_shipped     Decimal              @db.Decimal(14, 2)
  created_at           DateTime             @default(now())
  po_shipments         po_shipments         @relation(fields: [shipment_id], references: [id])
  purchase_order_items purchase_order_items @relation(fields: [po_item_id], references: [id])
  businesses           businesses           @relation(fields: [business_id], references: [id])

  @@index([shipment_id])
  @@index([po_item_id])
}

// shipment_id is optional -- null for PO-level milestones (e.g.
// production_started, recorded before any shipment exists yet). Never
// strictly sequence-enforced this session (real-world logistics reporting
// isn't always clean) -- variance (actualDate - plannedDate) is computed at
// query/report time, never a stored column, same "derive, don't store what
// can drift" principle already applied to Negotiation Status/Debt
// aging/Invoice Payment Status elsewhere in this codebase. Recording a
// milestone here, including warehouse_received/completed, never triggers or
// duplicates GRN creation -- GRN stays exactly as it already works
// (owner/storekeeper-initiated via its own existing endpoint), confirmed via
// Phase 0 that nothing else in this codebase calls it.
model po_delivery_milestones {
  id                String                @id
  business_id       String
  purchase_order_id String
  shipment_id       String?
  milestone         DeliveryMilestoneType
  planned_date      DateTime?
  actual_date       DateTime?
  recorded_from     PoNegotiationParty
  recorded_by_name  String?
  created_at        DateTime              @default(now())
  purchase_orders   purchase_orders       @relation(fields: [purchase_order_id], references: [id])
  po_shipments      po_shipments?         @relation(fields: [shipment_id], references: [id])
  businesses        businesses            @relation(fields: [business_id], references: [id])

  @@index([purchase_order_id])
  @@index([shipment_id])
}

// Append-only -- every arrival-window change is a NEW row, po_shipments'
// own expected_arrival_from/to get updated to the new values but the full
// history stays here forever. reason_category + reason are both required
// on every update (pick "other" if nothing else fits -- never optional,
// never losing analytics coverage).
model po_eta_updates {
  id                        String             @id
  business_id               String
  purchase_order_id         String
  shipment_id               String
  old_expected_arrival_from DateTime?
  old_expected_arrival_to   DateTime?
  new_expected_arrival_from DateTime?
  new_expected_arrival_to   DateTime?
  reason_category           EtaReasonCategory
  reason                    String
  updated_by_party          PoNegotiationParty
  updated_by_name           String?
  updated_at                DateTime           @default(now())
  purchase_orders           purchase_orders    @relation(fields: [purchase_order_id], references: [id])
  po_shipments              po_shipments       @relation(fields: [shipment_id], references: [id])
  businesses                businesses         @relation(fields: [business_id], references: [id])

  @@index([shipment_id])
}

// Reuses StorageProvider exactly (built PO Negotiation Session 1, already
// retrofitted onto Expense Attachments) -- no parallel storage abstraction.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model po_shipment_attachments {
  id                String                 @id
  business_id       String
  shipment_id       String
  type              ShipmentAttachmentType
  file_name         String
  file_size_bytes   Int
  storage_key       String
  uploaded_by_party PoNegotiationParty
  uploaded_by_name  String?
  uploaded_at       DateTime               @default(now())
  po_shipments      po_shipments           @relation(fields: [shipment_id], references: [id])
  businesses        businesses             @relation(fields: [business_id], references: [id])

  @@index([shipment_id])
}

// Addendum #11 -- a shipment's CURRENT status (po_shipments.status) and its
// historical journey are two separate business concepns. This table is the
// immutable audit trail of every state transition (never overwritten,
// always appended), the same architectural philosophy already used by
// debt_transactions/warehouse_movements/po_negotiation_agreement_snapshots.
// Deliberately distinct from the addendum's own "Shipment Audit Log"
// requirement (#21, operational changes like carrier/cost/tracking
// updates) -- that requirement is satisfied by this repo's existing
// generic, universal audit_logs table (used by every module for exactly
// this purpose already) rather than a second, shipment-only parallel
// table; this table captures ONLY structured from/to state transitions,
// a genuinely different shape audit_logs' own free-text reason field
// doesn't model as cleanly for building a status-timeline view.
model po_shipment_status_history {
  id               String             @id
  business_id      String
  shipment_id      String
  from_status      ShipmentStatus?
  to_status        ShipmentStatus
  changed_by_party PoNegotiationParty
  changed_by_name  String?
  changed_at       DateTime           @default(now())
  note             String?
  po_shipments     po_shipments       @relation(fields: [shipment_id], references: [id])
  businesses       businesses         @relation(fields: [business_id], references: [id])

  @@index([shipment_id])
}

// ============================================================================
// PO Supplier Negotiation Core (Session 1) -- a supplier-facing, token-
// authenticated portal (no login) for negotiating an already-SENT Purchase
// Order, plus the owner-side authenticated API. See CLAUDE.md's own
// "Purchase Orders -- PO Supplier Negotiation (Session 1)" section for the
// full design rationale (why Proposal is a header+child aggregate rather
// than one field-change, why Negotiation Status/Summary are derived not
// stored, why Internal Notes is a fully separate table).
// ============================================================================

enum PoSecureLinkStatus {
  active
  revoked
  expired
}

// One PO = one active link at a time -- generating a new one immediately
// revokes any prior active link for that PO. Token is SHA-256 hashed
// (src/lib/tokens.ts's existing hashToken, already used for session
// refresh tokens) -- the raw token is NEVER stored, matching sessions'
// own convention, deliberately NOT staff_invites' plaintext-token
// convention (that one is single-use/short-lived; this one is viewed
// repeatedly over up to 30 days by an unauthenticated party).
model po_secure_links {
  id                String             @id
  business_id       String
  purchase_order_id String
  token_hash        String             @unique
  status            PoSecureLinkStatus @default(active)
  // Fixed 30 days for v1, not business-configurable (locked decision,
  // confirmed both in the spec and independently in the Notion doc's own
  // "Open Question" resolution) -- fields-only, no settings-driven logic.
  expires_at        DateTime
  created_at        DateTime           @default(now())
  created_by        String
  revoked_at        DateTime?
  revoked_by        String?
  last_viewed_at    DateTime?
  view_count        Int                @default(0)
  purchase_orders   purchase_orders    @relation(fields: [purchase_order_id], references: [id])
  businesses        businesses         @relation(fields: [business_id], references: [id])
  users_created_by  users              @relation("po_secure_links_created_byTousers", fields: [created_by], references: [id])
  users_revoked_by  users?             @relation("po_secure_links_revoked_byTousers", fields: [revoked_by], references: [id])

  @@index([business_id])
  @@index([purchase_order_id])
}

// owner = authenticated staff action; supplier = token-authenticated public
// portal action; system = domain-event-triggered (e.g. an automated notice
// this session only publishes as an event, never sends -- see CLAUDE.md).
enum PoNegotiationParty {
  owner
  supplier
  system
}

// Module 33 Session 4B -- how a message actually reached po_negotiation_messages.
// portal = the existing owner/supplier-portal write endpoints (Session 1,
// unchanged); email = ingested from an inbound Resend webhook reply; system
// mirrors PoNegotiationParty's own reserved-but-unused value, kept for
// symmetry (no code path sets it yet, same as sender_type's own "system").
enum PoNegotiationMessageSource {
  portal
  email
  system
}

// Messages are fully immutable except the read_at/read_by pair, which is
// set exactly once (first read by the OTHER party only) and never
// overwritten on subsequent reads.
model po_negotiation_messages {
  id                  String                       @id
  business_id         String
  purchase_order_id   String
  sender_type         PoNegotiationParty
  // Suppliers have no user account in this system -- captured free-text at
  // send time, same reasoning throughout this whole module. department/role
  // let a large supplier's reply be attributed to e.g. "Ahmed Hassan, Sales
  // Manager" rather than just a bare name, improving audit quality when
  // replies come from Sales/Warehouse/Accounts/Logistics interchangeably.
  sender_name         String?
  sender_department   String?
  sender_role         String?
  message_text        String
  // Threading -- a message may optionally reply to an earlier one. Self-
  // relation; nullable since most messages are not replies.
  reply_to_message_id String?
  created_at          DateTime                     @default(now())
  ip_address          String?
  read_at             DateTime?
  read_by             PoNegotiationParty?
  // Module 33 Session 4B -- source defaults to "portal" so every one of
  // Session 1's own existing writes needs zero code change; "email" is set
  // only by the new inbound-webhook ingestion path. resend_email_id is the
  // secondary, defense-in-depth uniqueness guard for the same
  // resend_email_id dedup resend_inbound_claims already enforces as the
  // PRIMARY atomic claim (see that model's own comment) -- nullable, set
  // only on source="email" rows, giving direct traceability from a message
  // back to the exact inbound webhook event that created it.
  source              PoNegotiationMessageSource   @default(portal)
  resend_email_id     String?                      @unique
  purchase_orders     purchase_orders              @relation(fields: [purchase_order_id], references: [id])
  businesses          businesses                   @relation(fields: [business_id], references: [id])
  reply_to_message    po_negotiation_messages?     @relation("po_negotiation_messages_replies", fields: [reply_to_message_id], references: [id])
  replies             po_negotiation_messages[]    @relation("po_negotiation_messages_replies")
  attachments         po_negotiation_attachments[]

  @@index([business_id, purchase_order_id, created_at])
  @@index([reply_to_message_id])
}

enum PoNegotiationProposalStatus {
  draft
  pending
  accepted
  rejected
  superseded
}

// Every coordinated change a proposal touches -- quantity/price/delivery/
// shipping changes, product substitutions/additions/removals. Deliberately
// NOT one row per field per proposal event; see po_negotiation_proposals'
// own comment for why this is a header, not the ledger row itself.
enum PoNegotiationFieldChanged {
  quantity
  unit_price
  delivery_date
  shipping_method
  product_substitution
  product_added
  product_removed
}

// Aggregate root for one negotiation "turn." A single proposal bundles N
// coordinated changes (quantity + price + shipping method, etc.) submitted
// and resolved atomically -- never one proposal per field. Mutable ONLY
// while status=draft (the one explicit, locked exception to this whole
// schema's usual immutable-ledger rule); submitting (draft -> pending)
// locks it permanently from that point on, exactly like every other
// immutable ledger table here (debt_transactions, warehouse_movements,
// goods_received_notes). version guards concurrent draft edits (e.g. two
// browser tabs) -- irrelevant once submitted, since the row can't be
// written to at all past that point regardless of version.
model po_negotiation_proposals {
  id                  String                               @id
  business_id         String
  purchase_order_id   String
  proposed_by         PoNegotiationParty
  proposer_name       String?
  proposer_department String?
  proposer_role       String?
  // Optional comment bundled with the proposal itself (e.g. "Only 80 units
  // available, see attached photo") -- one per proposal, not one per change,
  // since real supplier replies bundle a rationale with several coordinated
  // changes as a single business communication, not several disconnected
  // messages.
  comment             String?
  status              PoNegotiationProposalStatus          @default(draft)
  version             Int                                  @default(0)
  // Sequential per PO, assigned on submit (draft -> pending), never on
  // draft save -- lets an owner say "this is Revision #4" without counting
  // rows by hand.
  revision_number     Int?
  created_at          DateTime                             @default(now())
  submitted_at        DateTime?
  resolved_at         DateTime?
  // Owner userId on accept/reject; a supplier-side resolution (not enabled
  // this session -- accept/reject is owner-only for v1) would store the
  // supplier's phone instead, same as every other supplier-attributable
  // field in this module -- never a users FK, since suppliers have none.
  resolved_by         String?
  ip_address          String?
  purchase_orders     purchase_orders                      @relation(fields: [purchase_order_id], references: [id])
  businesses          businesses                           @relation(fields: [business_id], references: [id])
  changes             po_negotiation_proposal_changes[]
  attachments         po_negotiation_attachments[]
  agreement_snapshots po_negotiation_agreement_snapshots[]

  @@index([business_id, purchase_order_id, status])
}

// Child rows -- one per coordinated change within a single proposal. No own
// status: the WHOLE proposal accepts/rejects atomically (the session's
// locked "Most Important Architectural Rule"), so there is nothing here to
// resolve independently. Mirrors goods_received_items' header+child shape
// (a GRN bundles N line items under one receipt) rather than
// debt_transactions/warehouse_movements' flat-ledger shape, since a
// proposal genuinely bundles N related facts under one resolution.
model po_negotiation_proposal_changes {
  id                       String                    @id
  business_id              String
  proposal_id              String
  field_changed            PoNegotiationFieldChanged
  // FK to purchase_order_items when the change is item-scoped (quantity/
  // unit_price/product_substitution/product_removed); null for PO-level
  // changes (delivery_date/shipping_method) and for product_added (the
  // product doesn't exist as a line item yet at proposal time).
  item_id                  String?
  old_value                String
  new_value                String
  created_at               DateTime                  @default(now())
  po_negotiation_proposals po_negotiation_proposals  @relation(fields: [proposal_id], references: [id])
  businesses               businesses                @relation(fields: [business_id], references: [id])
  purchase_order_items     purchase_order_items?     @relation(fields: [item_id], references: [id])

  @@index([proposal_id])
  @@index([item_id])
}

enum PoNegotiationAttachmentType {
  image
  pdf
  excel
  doc
  video
}

// Attachments are immutable once uploaded (upload/view only, no replace/
// edit). Exactly one of message_id/proposal_id must be set, validated at
// the service layer (Prisma has no native XOR constraint). storage_key
// flows through the new StorageProvider interface (src/storage/), the same
// seam Expense Attachments were retrofitted onto this session.
model po_negotiation_attachments {
  id                       String                      @id
  business_id              String
  purchase_order_id        String
  message_id               String?
  proposal_id              String?
  type                     PoNegotiationAttachmentType
  file_name                String
  file_size_bytes          Int
  storage_key              String
  uploaded_by              PoNegotiationParty
  uploaded_by_name         String?
  uploaded_at              DateTime                    @default(now())
