  expenses_expenses_approved_byTousers          expenses[]              @relation("expenses_approved_byTousers")
  expenses_expenses_rejected_byTousers          expenses[]              @relation("expenses_rejected_byTousers")
  expenses_expenses_paid_byTousers              expenses[]              @relation("expenses_paid_byTousers")
  expense_attachments                           expense_attachments[]
