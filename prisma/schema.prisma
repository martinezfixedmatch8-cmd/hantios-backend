generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model audit_logs {
  id             String     @id
  business_id    String
  user_id        String
  user_name      String
  user_role      String
  action         String
  entity_type    String
  entity_id      String
  before_state   Json?
  after_state    Json?
  reason         String
  ip_address     String?
  user_agent     String?
  correlation_id String?
  created_at     DateTime   @default(now())
  businesses     businesses @relation(fields: [business_id], references: [id])
  users          users      @relation(fields: [user_id], references: [id])

  @@index([business_id, created_at])
  @@index([business_id, entity_type, entity_id])
  @@index([business_id])
  @@index([user_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model branch_inventory {
  id           String     @id
  business_id  String
  branch_id    String
  product_id   String
  size         String?
  quantity     Decimal    @default(0) @db.Decimal(14, 2)
  last_updated DateTime   @default(now())
  version      Int        @default(0)
  branches     branches   @relation(fields: [branch_id], references: [id])
  businesses   businesses @relation(fields: [business_id], references: [id])
  products     products   @relation(fields: [product_id], references: [id])

  @@unique([branch_id, product_id, size])
  @@index([business_id])
}

model branches {
  id                               String                  @id
  business_id                      String
  name                             String
  location                         String?
  manager_id                       String?
  status                           RecordStatus            @default(active)
  created_at                       DateTime                @default(now())
  branch_inventory                 branch_inventory[]
  businesses                       businesses              @relation(fields: [business_id], references: [id])
  users_branches_manager_idTousers users?                  @relation("branches_manager_idTousers", fields: [manager_id], references: [id])
  debts                            debts[]
  expenses                         expenses[]
  inventory_adjustments            inventory_adjustments[]
  sales                            sales[]
  users_users_branch_idTobranches  users[]                 @relation("users_branch_idTobranches")

  @@index([business_id])
}

model businesses {
  id                                  String                  @id
  name                                String
  owner_id                            String?                 @unique
  plan                                String
  tier                                String
  country                             String
  phone_prefix                        String
  country_locked_at                   DateTime?
  timezone                            String
  currency                            String
  decimal_places                      Int                     @default(2)
  language                            String                  @default("en")
  fiscal_year_start_month             Int                     @default(1)
  fiscal_year_start_day               Int                     @default(1)
  settings                            Json                    @default("{}")
  created_at                          DateTime                @default(now())
  updated_at                          DateTime                @updatedAt
  audit_logs                          audit_logs[]
  branch_inventory                    branch_inventory[]
  branches                            branches[]
  users_businesses_owner_idTousers    users?                  @relation("businesses_owner_idTousers", fields: [owner_id], references: [id])
  categories                          categories[]
  customers                           customers[]
  debts                               debts[]
  expenses                            expenses[]
  idempotency_keys                    idempotency_keys[]
  inventory_adjustments               inventory_adjustments[]
  login_events                        login_events[]
  otp_challenges                      otp_challenges[]
  payment_methods                     payment_methods[]
  price_history                       price_history[]
  products                            products[]
  sales                               sales[]
  sessions                            sessions[]
  staff_invites                       staff_invites[]
  users_users_business_idTobusinesses users[]                 @relation("users_business_idTobusinesses")
  warehouse_stock                     warehouse_stock[]
  warehouses                          warehouses?
}

model categories {
  id               String       @id
  business_id      String
  parent_id        String?
  name             String
  created_at       DateTime     @default(now())
  businesses       businesses   @relation(fields: [business_id], references: [id])
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id])
  other_categories categories[] @relation("categoriesTocategories")
  products         products[]

  @@index([business_id])
}

model customers {
  id           String       @id
  business_id  String
  phone        String
  name         String?
  email        String?
  total_spent  Decimal      @default(0) @db.Decimal(14, 2)
  debt_balance Decimal      @default(0) @db.Decimal(14, 2)
  status       RecordStatus @default(active)
  created_at   DateTime     @default(now())
  businesses   businesses   @relation(fields: [business_id], references: [id])

  @@unique([business_id, phone])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model debts {
  id                    String     @id
  business_id           String
  branch_id             String?
  customer_phone        String
  customer_name         String?
  customer_location     String?
  amount_original       Decimal    @db.Decimal(14, 2)
  amount_paid           Decimal    @default(0) @db.Decimal(14, 2)
  amount_remaining      Decimal    @db.Decimal(14, 2)
  date_taken            DateTime   @db.Date
  date_due              DateTime   @db.Date
  interest_enabled      Boolean    @default(false)
  interest_rate         Decimal?   @db.Decimal(5, 2)
  notes                 String?
  status                DebtStatus @default(open)
  payment_history       Json       @default("[]")
  reminder_sent_before  Boolean    @default(false)
  reminder_sent_overdue Boolean    @default(false)
  disputed              Boolean    @default(false)
  created_at            DateTime   @default(now())
  sale_id               String?
  version               Int        @default(0)
  branches              branches?  @relation(fields: [branch_id], references: [id])
  businesses            businesses @relation(fields: [business_id], references: [id])
  sales                 sales?     @relation(fields: [sale_id], references: [id])

  @@index([business_id, date_due])
  @@index([business_id])
  @@index([business_id, status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model expenses {
  id              String       @id
  business_id     String
  branch_id       String?
  category        String
  amount          Decimal      @db.Decimal(14, 2)
  description     String?
  attachments     Json         @default("[]")
  approved_by     String?
  date            DateTime     @db.Date
  recurring       Boolean      @default(false)
  recurrence_rule String?
  status          RecordStatus @default(active)
  archived_reason String?
  created_at      DateTime     @default(now())
  users           users?       @relation(fields: [approved_by], references: [id])
  branches        branches?    @relation(fields: [branch_id], references: [id])
  businesses      businesses   @relation(fields: [business_id], references: [id])

  @@index([business_id, branch_id])
  @@index([business_id, category])
  @@index([business_id, date])
  @@index([business_id])
}

model idempotency_keys {
  id              String     @id
  business_id     String
  key             String
  endpoint        String
  response_status Int
  response_body   Json
  created_at      DateTime   @default(now())
  businesses      businesses @relation(fields: [business_id], references: [id])

  @@unique([business_id, key, endpoint])
  @@index([business_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_adjustments {
  id                String         @id
  business_id       String
  product_id        String
  branch_id         String
  quantity_before   Decimal        @db.Decimal(14, 2)
  quantity_after    Decimal        @db.Decimal(14, 2)
  adjustment_amount Decimal        @db.Decimal(14, 2)
  adjustment_type   AdjustmentType
  packaging_level   PackagingLevel @default(each)
  reason            String
  adjusted_by       String
  created_at        DateTime       @default(now())
  users             users          @relation(fields: [adjusted_by], references: [id])
  branches          branches       @relation(fields: [branch_id], references: [id])
  businesses        businesses     @relation(fields: [business_id], references: [id])
  products          products       @relation(fields: [product_id], references: [id])

  @@index([business_id, branch_id])
  @@index([business_id, created_at])
  @@index([business_id])
  @@index([business_id, product_id])
}

model login_events {
  id             String      @id
  business_id    String?
  user_id        String?
  email          String
  success        Boolean
  method         String
  ip_address     String?
  user_agent     String?
  device_id      String?
  suspicious     Boolean     @default(false)
  failure_reason String?
  created_at     DateTime    @default(now())
  businesses     businesses? @relation(fields: [business_id], references: [id])
  users          users?      @relation(fields: [user_id], references: [id])

  @@index([business_id])
  @@index([user_id])
}

model otp_challenges {
  id           String     @id
  business_id  String
  user_id      String
  code_hash    String
  attempts     Int        @default(0)
  max_attempts Int        @default(5)
  expires_at   DateTime
  consumed_at  DateTime?
  created_at   DateTime   @default(now())
  purpose      OtpPurpose
  businesses   businesses @relation(fields: [business_id], references: [id])
  users        users      @relation(fields: [user_id], references: [id])

  @@index([business_id])
  @@index([user_id])
}

model password_history {
  id            String   @id
  user_id       String
  password_hash String
  created_at    DateTime @default(now())
  users         users    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
}

model payment_methods {
  id             String       @id
  business_id    String
  name           String
  logo_url       String?
  account_number String?
  description    String?
  status         RecordStatus @default(active)
  created_at     DateTime     @default(now())
  businesses     businesses   @relation(fields: [business_id], references: [id])
  sales          sales[]

  @@index([business_id])
}

model price_history {
  id          String     @id
  business_id String
  product_id  String
  old_price   Decimal    @db.Decimal(14, 2)
  new_price   Decimal    @db.Decimal(14, 2)
  changed_by  String
  changed_at  DateTime   @default(now())
  reason      String
  businesses  businesses @relation(fields: [business_id], references: [id])
  users       users      @relation(fields: [changed_by], references: [id])
  products    products   @relation(fields: [product_id], references: [id])

  @@index([business_id])
}

model products {
  id                    String                  @id
  business_id           String
  name                  String
  sku                   String?
  barcode               String?
  category_id           String?
  cost_price            Decimal                 @db.Decimal(14, 2)
  selling_price         Decimal                 @db.Decimal(14, 2)
  sizes                 Json                    @default("[]")
  unit_type             String                  @default("each")
  packaging_hierarchy   Json                    @default("{}")
  min_stock_level       Decimal?                @db.Decimal(14, 2)
  images                Json                    @default("[]")
  status                RecordStatus            @default(active)
  created_at            DateTime                @default(now())
  updated_at            DateTime                @updatedAt
  branch_inventory      branch_inventory[]
  inventory_adjustments inventory_adjustments[]
  price_history         price_history[]
  businesses            businesses              @relation(fields: [business_id], references: [id])
  categories            categories?             @relation(fields: [category_id], references: [id])
  warehouse_stock       warehouse_stock[]

  @@index([business_id, barcode])
  @@index([business_id, created_at])
  @@index([business_id])
  @@index([business_id, sku])
  @@index([business_id, status])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sales {
  id                              String           @id
  business_id                     String
  branch_id                       String
  cashier_id                      String
  customer_phone                  String?
  items                           Json
  subtotal                        Decimal          @db.Decimal(14, 2)
  discount                        Decimal          @default(0) @db.Decimal(14, 2)
  discount_type                   DiscountType?
  tax_amount                      Decimal          @default(0) @db.Decimal(14, 2)
  fee_amount                      Decimal          @default(0) @db.Decimal(14, 2)
  total                           Decimal          @db.Decimal(14, 2)
  payment_method_id               String?
  payment_reference               String?
  confirmed_by                    String?
  profit                          Decimal          @db.Decimal(14, 2)
  receipt_id                      String?
  status                          SaleStatus       @default(completed)
  void_reason                     String?
  timestamp                       DateTime         @default(now())
  refund_of_sale_id               String?
  version                         Int              @default(0)
  debts                           debts[]
  branches                        branches         @relation(fields: [branch_id], references: [id])
  businesses                      businesses       @relation(fields: [business_id], references: [id])
  users_sales_cashier_idTousers   users            @relation("sales_cashier_idTousers", fields: [cashier_id], references: [id])
  users_sales_confirmed_byTousers users?           @relation("sales_confirmed_byTousers", fields: [confirmed_by], references: [id])
  payment_methods                 payment_methods? @relation(fields: [payment_method_id], references: [id])
  sales                           sales?           @relation("salesTosales", fields: [refund_of_sale_id], references: [id])
  other_sales                     sales[]          @relation("salesTosales")

  @@index([business_id, branch_id])
  @@index([business_id])
  @@index([business_id, status])
  @@index([business_id, timestamp])
}

model sessions {
  id                 String     @id
  business_id        String
  user_id            String
  refresh_token_hash String
  device_id          String
  ip_address         String?
  user_agent         String?
  created_at         DateTime   @default(now())
  last_active_at     DateTime   @default(now())
  expires_at         DateTime
  revoked_at         DateTime?
  remember_me        Boolean    @default(false)
  businesses         businesses @relation(fields: [business_id], references: [id])
  users              users      @relation(fields: [user_id], references: [id])

  @@index([business_id])
  @@index([user_id])
}

model staff_invites {
  id                                    String     @id
  business_id                           String
  user_id                               String
  invited_by                            String
  expires_at                            DateTime
  accepted_at                           DateTime?
  revoked_at                            DateTime?
  created_at                            DateTime   @default(now())
  businesses                            businesses @relation(fields: [business_id], references: [id])
  users_staff_invites_invited_byTousers users      @relation("staff_invites_invited_byTousers", fields: [invited_by], references: [id])
  users_staff_invites_user_idTousers    users      @relation("staff_invites_user_idTousers", fields: [user_id], references: [id])

  @@index([business_id, created_at])
  @@index([user_id, expires_at])
}

model users {
  id                                            String                  @id
  business_id                                   String
  branch_id                                     String?
  name                                          String
  phone                                         String
  password_hash                                 String?
  role                                          UserRole
  permissions                                   Json                    @default("{}")
  last_login                                    DateTime?
  status                                        RecordStatus            @default(active)
  created_at                                    DateTime                @default(now())
  updated_at                                    DateTime                @updatedAt
  failed_login_attempts                         Int                     @default(0)
  locked_until                                  DateTime?
  email                                         String                  @unique
  oauth_provider                                AuthProvider?
  oauth_provider_id                             String?
  phone_verified_at                             DateTime?
  privacy_accepted_at                           DateTime?
  privacy_version                               String?
  terms_accepted_at                             DateTime?
  terms_version                                 String?
  activated_at                                  DateTime?
  deactivated_at                                DateTime?
  deactivated_by                                String?
  restore_reason                                String?
  email_verification_expires_at                 DateTime?
  email_verification_token                      String?
  email_verified_at                             DateTime?
  audit_logs                                    audit_logs[]
  branches_branches_manager_idTousers           branches[]              @relation("branches_manager_idTousers")
  businesses_businesses_owner_idTousers         businesses?             @relation("businesses_owner_idTousers")
  expenses                                      expenses[]
  inventory_adjustments                         inventory_adjustments[]
  login_events                                  login_events[]
  otp_challenges                                otp_challenges[]
  password_history                              password_history[]
  price_history                                 price_history[]
  sales_sales_cashier_idTousers                 sales[]                 @relation("sales_cashier_idTousers")
  sales_sales_confirmed_byTousers               sales[]                 @relation("sales_confirmed_byTousers")
  sessions                                      sessions[]
  staff_invites_staff_invites_invited_byTousers staff_invites[]         @relation("staff_invites_invited_byTousers")
  staff_invites_staff_invites_user_idTousers    staff_invites[]         @relation("staff_invites_user_idTousers")
  branches_users_branch_idTobranches            branches?               @relation("users_branch_idTobranches", fields: [branch_id], references: [id])
  businesses_users_business_idTobusinesses      businesses              @relation("users_business_idTobusinesses", fields: [business_id], references: [id])
  users                                         users?                  @relation("usersTousers", fields: [deactivated_by], references: [id])
  other_users                                   users[]                 @relation("usersTousers")

  @@unique([business_id, phone])
  @@unique([oauth_provider, oauth_provider_id])
}

model warehouse_stock {
  id           String     @id
  business_id  String
  warehouse_id String
  product_id   String
  size         String?
  quantity     Decimal    @default(0) @db.Decimal(14, 2)
  location     String?
  last_updated DateTime   @default(now())
  businesses   businesses @relation(fields: [business_id], references: [id])
  products     products   @relation(fields: [product_id], references: [id])
  warehouses   warehouses @relation(fields: [warehouse_id], references: [id])

  @@unique([warehouse_id, product_id, size])
  @@index([business_id])
}

model warehouses {
  id              String            @id
  business_id     String            @unique
  name            String            @default("Main Warehouse")
  location        String?
  created_at      DateTime          @default(now())
  warehouse_stock warehouse_stock[]
  businesses      businesses        @relation(fields: [business_id], references: [id])
}

enum AdjustmentType {
  increase
  decrease
  damage
  loss
  found
  correction
  opening_balance
  transfer
}

enum AuthProvider {
  google
}

enum DebtStatus {
  open
  partially_paid
  paid
  disputed
}

enum DiscountType {
  fixed
  percentage
}

enum OtpPurpose {
  signup
  password_reset
  staff_invite
}

enum PackagingLevel {
  each
  inner_pack
  box
  carton
  pallet
}

enum RecordStatus {
  active
  archived
}

enum SaleStatus {
  completed
  void
  refunded
  draft
}

enum UserRole {
  super_admin
  owner
  manager
  accountant
  storekeeper
  cashier
  shareholder
  custom
}
