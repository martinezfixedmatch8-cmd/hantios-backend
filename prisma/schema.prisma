model warehouse_stock {
  id           String     @id
  business_id  String
  warehouse_id String
  product_id   String
  // GOTCHA, deliberate departure from branch_inventory's own convention:
  // "no size" is stored as an EMPTY STRING (""), never NULL, even though
  // this column is still nullable at the type level. Postgres does not
  // treat NULL as equal to NULL for uniqueness, so @@unique([warehouse_id,
  // product_id, size]) below can never fire on NULL, silently allowing
  // duplicate rows under concurrent writes (confirmed live, Module 11
  // Session B) -- "" makes the constraint a real guard. Every current
  // reader/writer (src/lib/warehouseStock.ts's recordWarehouseMovement,
  // the sole choke point for this table) already follows this. Any FUTURE
  // code that reads or writes this table directly -- a Stock Count/Reports
  // Center list endpoint, a manual DB script, anything bypassing
  // recordWarehouseMovement -- MUST do the same: query/compare against ""
  // for "no size," never `null`, or rows will silently stop matching.
  size         String?
  quantity     Decimal    @default(0) @db.Decimal(14, 2)
  // Free-text display override, kept alongside the discrete fields below
  // rather than replaced -- e.g. a combined "A-01-B" summary string.
  location     String?
  // Module 11 Session B -- simple discrete addressing fields, not
  // barcode/RFID infrastructure. All independently optional.
  shelf        String?
  row_label    String?
  section      String?
  bin          String?
  rack         String?
  // Module 11 Session B -- optimistic locking, same pattern as every other
  // mutable financial/inventory row in this schema. The atomic
  // quantity-guarded updateMany (Stock In/Out) is still the real safety net;
  // this is defense-in-depth/consistency, not the sole guard.
  version      Int        @default(0)
  last_updated DateTime   @default(now())
  businesses   businesses @relation(fields: [business_id], references: [id])
  products     products   @relation(fields: [product_id], references: [id])
  warehouses   warehouses @relation(fields: [warehouse_id], references: [id])

  @@unique([warehouse_id, product_id, size])
  @@index([business_id])
}

// Backs Sale Creation's Receipt Number (customer-facing, e.g. INV-2026-000001) --
// distinct from Sale Number (sales.id, already immutable/unique/never-reused).
// One row per (business, calendar year in Business.timezone); last_number is
// incremented via a single atomic `INSERT ... ON CONFLICT ... DO UPDATE ... RETURNING`
// statement (src/lib/receiptNumber.ts) inside the sale's own transaction -- never
// SELECT MAX+1, which would race under concurrent sales.
model receipt_counters {
  id          String     @id
  business_id String
  year        Int
  last_number Int        @default(0)
  businesses  businesses @relation(fields: [business_id], references: [id])

  @@unique([business_id, year])
  @@index([business_id])
}

model warehouses {
  id                  String                @id
  business_id         String                @unique
  name                String                @default("Main Warehouse")
  location            String?
  created_at          DateTime              @default(now())
  warehouse_stock     warehouse_stock[]
  warehouse_movements warehouse_movements[]
  businesses          businesses            @relation(fields: [business_id], references: [id])
}

enum WarehouseMovementType {
  stock_in
  stock_out
}

// LOCKED enum -- without this, Stock Out history is much less useful for
// later reporting/analysis.
enum WarehouseStockOutReason {
  branch_transfer
  adjustment
  damage
  return
  other
}

// Module 11 Session B -- one shared immutable ledger for both Stock In and
// Stock Out (mirrors inventory_adjustments' own precedent: one table for
// heterogeneous movement sources via an enum, not a parallel table per
// source). Type-specific fields are nullable and populated per
// movement_type. No update/delete code path for any row -- permanent
// history, same rule as goods_received_notes/inventory_adjustments/audit_logs.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model warehouse_movements {
  id                    String                   @id
  business_id           String
  warehouse_id          String
  // WSM-000001, sequential per business, immutable -- ONE shared sequence
  // covering both stock_in and stock_out rows. See warehouseMovementNumber.ts.
  movement_number       String
  movement_type         WarehouseMovementType
  product_id            String
  quantity              Decimal                  @db.Decimal(14, 2)
  // Snapshot pair around this movement, mirroring inventory_adjustments'
  // own quantity_before/quantity_after precedent -- quantity_after is
  // quantity_before + quantity for stock_in, quantity_before - quantity for
  // stock_out. `quantity` itself stays a positive amount either way (CHECK
  // chk_warehouse_movements_quantity_positive), direction is movement_type.
  quantity_before       Decimal                  @db.Decimal(14, 2)
  quantity_after        Decimal                  @db.Decimal(14, 2)
  // Stock In only:
  grn_id                String?
  unit_cost             Decimal?                 @db.Decimal(14, 2)
  // Stock Out only. destination_branch_id is the minimal "Stock Out Receipt"
  // record (Module 06/Receipts doesn't exist yet) -- this row itself, via
  // movement_number, serves as the receipt until a real Receipts module
  // supersedes it.
  destination_branch_id String?
  reason                WarehouseStockOutReason?
  notes                 String?
  created_by            String
  created_at            DateTime                 @default(now())
  businesses            businesses               @relation(fields: [business_id], references: [id])
  warehouses            warehouses               @relation(fields: [warehouse_id], references: [id])
  products              products                 @relation(fields: [product_id], references: [id])
  goods_received_notes  goods_received_notes?    @relation(fields: [grn_id], references: [id])
  branches              branches?                @relation(fields: [destination_branch_id], references: [id])
  users                 users                    @relation(fields: [created_by], references: [id])
  // Module 06 (Receipt System) -- Stock Out only in practice (Stock In is
  // GRN-triggered receiving, its own separate receipt type sourced from
  // goods_received_notes instead).
  receipts              receipts[]

  @@unique([business_id, movement_number])
  @@index([business_id, movement_type])
  @@index([business_id, product_id])
  @@index([warehouse_id])
}

// Warehouse Movement Number sequence -- mirrors po_counters/grn_counters
// exactly, shared by both Stock In and Stock Out.
model wsm_counters {
  id          String     @id
  business_id String     @unique
  last_number Int        @default(0)
  businesses  businesses @relation(fields: [business_id], references: [id])
}

